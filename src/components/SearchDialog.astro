---
interface SearchPost {
	title: string;
	description: string;
	href: string;
	date: string;
	tags: string[];
}

interface Props {
	posts: SearchPost[];
}

const { posts } = Astro.props;
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
	<div class="search-panel">
		<header class="search-header">
			<div>
				<h2 id="search-title">搜索文章</h2>
				<p>输入标题、摘要或标签</p>
			</div>
			<button class="icon-button" type="button" data-search-close aria-label="关闭搜索">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
		</header>

		<label class="search-field">
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.2 16.2 4.3 4.3" /></svg>
			<span class="sr-only">搜索关键词</span>
			<input type="search" data-search-input autocomplete="off" placeholder="例如：阅读、技术、笔记" />
			<kbd>Esc</kbd>
		</label>

		<div class="search-summary" aria-live="polite" data-search-summary>共 {posts.length} 篇文章</div>
		<ul class="search-results" data-search-results>
			{posts.map((post) => (
				<li data-search-item data-search-text={`${post.title} ${post.description} ${post.tags.join(' ')}`.toLocaleLowerCase('zh-CN')}>
					<a href={post.href}>
						<div class="result-meta"><time>{post.date}</time><span>{post.tags[0] ?? '随笔'}</span></div>
						<h3>{post.title}</h3>
						<p>{post.description}</p>
					</a>
				</li>
			))}
		</ul>
		<p class="search-empty" data-search-empty hidden>没有找到相关文章，换个关键词试试。</p>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
	const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
	const items = [...(dialog?.querySelectorAll<HTMLElement>('[data-search-item]') ?? [])];
	const summary = dialog?.querySelector<HTMLElement>('[data-search-summary]');
	const empty = dialog?.querySelector<HTMLElement>('[data-search-empty]');

	const filterResults = () => {
		const query = input?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
		let visibleCount = 0;

		items.forEach((item) => {
			const matches = !query || item.dataset.searchText?.includes(query);
			item.hidden = !matches;
			if (matches) visibleCount += 1;
		});

		if (summary) summary.textContent = query ? `找到 ${visibleCount} 篇文章` : `共 ${visibleCount} 篇文章`;
		if (empty) empty.hidden = visibleCount > 0;
	};

	document.querySelectorAll<HTMLButtonElement>('[data-search-open]').forEach((button) => {
		button.addEventListener('click', () => {
			dialog?.showModal();
			requestAnimationFrame(() => input?.focus());
		});
	});

	dialog?.querySelector<HTMLButtonElement>('[data-search-close]')?.addEventListener('click', () => dialog.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
	input?.addEventListener('input', filterResults);
</script>

<style>
	.search-dialog {
		width: min(42rem, calc(100% - 2rem));
		max-height: min(42rem, calc(100dvh - 2rem));
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
		color: var(--ink);
		box-shadow: var(--shadow-raised);
	}
	.search-dialog::backdrop { background: color-mix(in srgb, #171421 45%, transparent); backdrop-filter: blur(8px); }
	.search-panel { display: flex; max-height: min(42rem, calc(100dvh - 2rem)); flex-direction: column; padding: 1.35rem; }
	.search-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: .2rem .2rem 1rem; }
	.search-header h2 { margin: 0; font-size: 1.45rem; letter-spacing: -.02em; }
	.search-header p { margin: .3rem 0 0; color: var(--muted); font-size: .82rem; }
	.icon-button { display: grid; width: 2.4rem; height: 2.4rem; padding: 0; border: 0; place-items: center; border-radius: 50%; background: var(--paper-deep); color: var(--muted); cursor: pointer; }
	.icon-button:hover { background: var(--accent-soft); color: var(--accent-ink); }
	.icon-button svg { width: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
	.search-field { display: flex; min-height: 3.4rem; align-items: center; gap: .8rem; padding: 0 1rem; border: 1px solid var(--line); border-radius: var(--radius-small); background: var(--paper); }
	.search-field:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
	.search-field svg { width: 1.1rem; flex: none; fill: none; stroke: var(--muted); stroke-linecap: round; stroke-width: 1.8; }
	.search-field input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: .94rem; line-height: 1.4; }
	.search-field input::placeholder { color: color-mix(in srgb, var(--muted) 78%, transparent); }
	kbd { padding: .15rem .4rem; border: 1px solid var(--line); border-radius: .35rem; color: var(--muted); font-family: var(--font-body); font-size: .68rem; }
	.search-summary { padding: 1rem .25rem .65rem; color: var(--muted); font-size: .76rem; }
	.search-results { display: grid; overflow-y: auto; gap: .5rem; margin: 0; padding: 0 .1rem .1rem; list-style: none; }
	.search-results a { display: block; padding: 1rem; border-radius: var(--radius-small); color: var(--ink); text-decoration: none; transition: background-color .2s ease, transform .2s ease; }
	.search-results a:hover { background: var(--surface-blue); transform: translateX(.2rem); }
	.result-meta { display: flex; gap: .6rem; color: var(--muted); font-size: .7rem; }
	.result-meta span { color: var(--accent-ink); }
	.search-results h3 { margin: .45rem 0 .3rem; font-size: 1.02rem; }
	.search-results p { overflow: hidden; margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.55; text-overflow: ellipsis; white-space: nowrap; }
	.search-empty { margin: 1.5rem 0; color: var(--muted); text-align: center; }
	@media (max-width: 520px) {
		.search-panel { padding: 1rem; }
		.search-field kbd { display: none; }
	}
</style>
