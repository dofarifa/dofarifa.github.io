---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		position: relative;
		display: inline-flex;
		height: var(--nav-control-size, 2.55rem);
		align-items: center;
		padding: 0 .62rem;
		border-radius: .7rem;
		color: var(--header-link-color, var(--muted));
		font-size: .9rem;
		font-weight: 740;
		letter-spacing: .018em;
		line-height: 1;
		text-decoration: none;
		transition: background-color .2s ease, color .2s ease, transform .2s ease;
	}
	a::after {
		position: absolute;
		right: .62rem;
		bottom: .12rem;
		left: .62rem;
		height: 2px;
		border-radius: 999px;
		background: var(--header-link-indicator, var(--accent));
		box-shadow: 0 .22rem .65rem color-mix(in srgb, var(--header-link-indicator, var(--accent)) 34%, transparent);
		content: "";
		opacity: 0;
		transform: scaleX(.45);
		transition: opacity .2s ease, transform .2s ease;
	}
	a:hover {
		background: transparent;
		color: var(--header-link-hover-color, var(--ink));
		transform: translateY(-1px);
	}
	a.active {
		background: transparent;
		color: var(--header-link-active-color, var(--accent-ink));
	}
	a.active::after {
		opacity: var(--header-link-indicator-opacity, .72);
		transform: scaleX(1);
	}
</style>
