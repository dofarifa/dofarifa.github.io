---
import { NETEASE_PLAYLIST_ID } from '../consts';
---

<aside
	class="mini-player"
	data-mini-player
	data-playlist-id={NETEASE_PLAYLIST_ID}
	data-visible="false"
	data-expanded="false"
	aria-label="正在播放"
>
	<div class="mini-backdrop" data-mini-backdrop aria-hidden="true"></div>
	<a class="mini-track" href="/music" aria-label="打开歌单页面">
		<span class="mini-cover" data-mini-cover aria-hidden="true"></span>
		<span class="mini-copy">
			<strong data-mini-title>尚未播放</strong>
			<small data-mini-author>网易云音乐</small>
		</span>
	</a>
	<div class="mini-actions">
		<button type="button" data-mini-previous aria-label="上一首" title="上一首">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 6l-8 6 8 6V6Z" /></svg>
		</button>
		<button class="mini-play" type="button" data-mini-play aria-label="播放">
			<svg data-mini-play-icon viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg>
			<svg data-mini-pause-icon data-icon-hidden="true" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
		</button>
		<button type="button" data-mini-next aria-label="下一首" title="下一首">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 6l8 6-8 6V6Z" /></svg>
		</button>
	</div>
	<span class="mini-progress" data-mini-progress aria-hidden="true"></span>
	<audio data-global-audio data-initial-volume="0.65" preload="metadata" transition:persist="kkkk-global-music-audio"></audio>
</aside>

<script src="../scripts/global-music-player.ts"></script>

<style>
	.mini-player {
		position: fixed;
		z-index: 30;
		left: max(1rem, env(safe-area-inset-left));
		bottom: 1.2rem;
		display: grid;
		overflow: hidden;
		width: min(19.5rem, calc(100% - 2rem));
		min-height: 4.8rem;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: .8rem;
		padding: .56rem .68rem .68rem .56rem;
		border: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
		border-radius: 999px;
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--surface) 88%, transparent), color-mix(in srgb, var(--surface-lilac) 54%, transparent)),
			color-mix(in srgb, var(--surface) 88%, transparent);
		box-shadow: 0 1rem 2.6rem color-mix(in srgb, var(--ink) 15%, transparent), inset 0 1px 0 color-mix(in srgb, white 14%, transparent);
		backdrop-filter: blur(22px) saturate(1.08);
		opacity: 0;
		pointer-events: none;
		transform: translateY(.55rem);
		visibility: hidden;
		transition: width .28s cubic-bezier(.22, 1, .36, 1), opacity .2s ease, transform .28s cubic-bezier(.22, 1, .36, 1), visibility .2s ease;
		isolation: isolate;
	}
	.mini-player[data-visible='true'] { opacity: 1; pointer-events: auto; transform: translateY(0); visibility: visible; }
	.mini-backdrop { position: absolute; z-index: -1; inset: -1.2rem; background: var(--surface-lilac) center / cover no-repeat; filter: blur(24px) saturate(1.08); opacity: .24; transition: background-image .6s cubic-bezier(.22, 1, .36, 1); }
	.mini-track { display: flex; overflow: hidden; min-width: 0; align-items: center; gap: .82rem; color: var(--ink); text-decoration: none; }
	.mini-cover { width: 3.5rem; height: 3.5rem; flex: none; border-radius: 1.12rem; background: var(--surface-lilac) center / cover no-repeat; box-shadow: 0 .4rem 1rem color-mix(in srgb, var(--ink) 16%, transparent); }
	.mini-copy { overflow: hidden; min-width: 0; padding-right: .35rem; transform: translateY(-.08rem); }
	.mini-copy strong, .mini-copy small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mini-copy strong { color: color-mix(in srgb, var(--ink) 94%, white 8%); font-size: .86rem; font-weight: 760; letter-spacing: -.018em; line-height: 1.25; }
	.mini-copy small { margin-top: .28rem; color: color-mix(in srgb, var(--muted) 86%, var(--ink)); font-size: .66rem; font-weight: 620; letter-spacing: .015em; line-height: 1.2; text-transform: uppercase; }
	.mini-actions { display: flex; overflow: hidden; width: 0; flex: none; align-items: center; gap: .25rem; padding: .24rem 0; border-radius: 999px; background: color-mix(in srgb, var(--paper) 62%, transparent); opacity: 0; pointer-events: none; transform: translateX(-.45rem) scale(.96); transition: width .28s cubic-bezier(.22, 1, .36, 1), padding-inline .28s cubic-bezier(.22, 1, .36, 1), opacity .18s ease, transform .28s cubic-bezier(.22, 1, .36, 1); }
	.mini-player:hover, .mini-player:focus-within, .mini-player[data-expanded='true'] { width: min(26rem, calc(100% - 2rem)); }
	.mini-player:hover .mini-actions, .mini-player:focus-within .mini-actions, .mini-player[data-expanded='true'] .mini-actions { width: 8.7rem; padding-inline: .24rem; opacity: 1; pointer-events: auto; transform: translateX(0) scale(1); }
	.mini-actions button { display: grid; width: 2.28rem; height: 2.28rem; padding: 0; border: 0; place-items: center; border-radius: 999px; background: color-mix(in srgb, var(--surface) 56%, transparent); color: color-mix(in srgb, var(--ink) 88%, var(--accent)); cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s cubic-bezier(.22, 1, .36, 1); }
	.mini-actions button:hover { background: color-mix(in srgb, var(--accent-soft) 88%, white 4%); color: var(--accent-ink); transform: translateY(-1px); }
	.mini-actions .mini-play { width: 2.9rem; height: 2.9rem; background: var(--accent); color: var(--accent-contrast); box-shadow: 0 .45rem 1.05rem color-mix(in srgb, var(--accent) 30%, transparent); }
	.mini-actions .mini-play:hover { background: var(--accent-ink); color: var(--accent-contrast); }
	.mini-actions svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.mini-actions svg[data-icon-hidden='true'] { display: none; }
	.mini-actions [data-mini-play-icon] { fill: currentColor; stroke: none; transform: translateX(.05rem); }
	.mini-progress { position: absolute; right: 1.25rem; bottom: .48rem; left: 4.95rem; height: .16rem; border-radius: 999px; background: linear-gradient(to right, color-mix(in srgb, var(--accent) 92%, white 8%) var(--mini-progress, 0%), color-mix(in srgb, var(--muted) 22%, transparent) var(--mini-progress, 0%)); opacity: .86; transition: right .28s cubic-bezier(.22, 1, .36, 1), opacity .2s ease; }
	.mini-player:hover .mini-progress, .mini-player:focus-within .mini-progress, .mini-player[data-expanded='true'] .mini-progress { right: 10.4rem; opacity: .72; }
	@media (max-width: 640px) {
		.mini-player { right: auto; bottom: calc(.6rem + env(safe-area-inset-bottom)); left: max(.6rem, env(safe-area-inset-left)); width: min(18.5rem, calc(100% - 1.2rem)); min-height: 4.45rem; padding: .48rem .54rem .62rem; }
		.mini-player:hover, .mini-player:focus-within, .mini-player[data-expanded='true'] { width: calc(100% - 1.2rem); }
		.mini-cover { width: 3.15rem; height: 3.15rem; border-radius: 1rem; }
		.mini-actions button:first-child { display: none; }
		.mini-actions .mini-play { width: 2.6rem; height: 2.6rem; }
		.mini-progress { right: 1rem; left: 4.4rem; }
	}
	@media (hover: none), (pointer: coarse) {
		.mini-player[data-expanded='true'] .mini-actions { width: 5.45rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.mini-actions button { transition: none; }
	}
</style>
