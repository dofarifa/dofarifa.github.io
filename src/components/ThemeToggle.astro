<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="切换到深色模式"
	aria-pressed="false"
	title="切换到深色模式"
>
	<svg class="theme-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20.1 15.2A8.2 8.2 0 0 1 8.8 3.9 8.6 8.6 0 1 0 20.1 15.2Z" />
	</svg>
	<svg class="theme-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="3.5" />
		<path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
	</svg>
</button>

<script>
	type Theme = 'light' | 'dark';

	const storageKey = 'kkkk-theme';
	const root = document.documentElement;
	const themeColors: Record<Theme, string> = {
		light: '#f8f7fb',
		dark: '#181722',
	};

	const readStoredTheme = (): Theme | null => {
		try {
			const storedTheme = localStorage.getItem(storageKey);
			return storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : null;
		} catch {
			return null;
		}
	};

	const currentTheme = (): Theme => root.dataset.theme === 'dark' ? 'dark' : 'light';

	const updateControls = (theme: Theme) => {
		const isDark = theme === 'dark';
		const actionLabel = isDark ? '切换到浅色模式' : '切换到深色模式';

		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
			button.setAttribute('aria-label', actionLabel);
			button.setAttribute('aria-pressed', String(isDark));
			button.title = actionLabel;
		});

		document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')
			?.setAttribute('content', themeColors[theme]);
	};

	const applyTheme = (theme: Theme, persist: boolean) => {
		root.dataset.theme = theme;
		root.style.colorScheme = theme;

		if (persist) {
			try {
				localStorage.setItem(storageKey, theme);
			} catch {
				// The selected theme still applies when storage is unavailable.
			}
		}

		updateControls(theme);
	};

	const setupThemeControls = () => {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
			if (button.dataset.initialized === 'true') return;
			button.dataset.initialized = 'true';
			button.addEventListener('click', () => {
				applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', true);
			});
		});
		updateControls(currentTheme());
	};

	window.addEventListener('storage', (event) => {
		if (event.key !== storageKey) return;
		const storedTheme = readStoredTheme();
		applyTheme(storedTheme ?? 'light', false);
	});

	setupThemeControls();
	document.addEventListener('astro:page-load', setupThemeControls);
</script>

<style>
	.theme-toggle {
		position: relative;
		display: grid;
		width: 2.4rem;
		height: 2.4rem;
		padding: 0;
		border: 0;
		place-items: center;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: background-color .2s ease, color .2s ease, transform .2s ease;
	}

	.theme-toggle:hover {
		background: var(--accent-soft);
		color: var(--accent-ink);
		transform: rotate(-8deg);
	}

	.theme-toggle:active { transform: rotate(-8deg) scale(.92); }

	.theme-icon {
		position: absolute;
		width: 1.05rem;
		height: 1.05rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transition: opacity .25s ease, transform .35s cubic-bezier(.2, .8, .2, 1);
	}

	.moon-icon { fill: currentColor; stroke: none; }
	.sun-icon { opacity: 0; transform: rotate(-70deg) scale(.55); }

	:global([data-theme='dark']) .moon-icon { opacity: 0; transform: rotate(70deg) scale(.55); }
	:global([data-theme='dark']) .sun-icon { opacity: 1; transform: rotate(0) scale(1); }

	@media (forced-colors: active) {
		.theme-toggle { border: 1px solid ButtonText; }
	}
</style>
