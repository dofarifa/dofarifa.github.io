---
import { COMMENTS_ENABLED, COMMENTS_ISSUE_TERM, COMMENTS_LABEL, COMMENTS_REPO } from '../consts';

interface Props {
	title: string;
}

const { title } = Astro.props;
const commentsReady = COMMENTS_ENABLED && Boolean(COMMENTS_REPO);
---

<section class="comment-card" aria-labelledby="comment-title">
	<div class="comment-orb" aria-hidden="true"></div>
	<div class="comment-heading">
		<div>
			<h2 id="comment-title">评论</h2>
			<p>读完之后，可以把你的想法留在这里。</p>
		</div>
		<a href={`https://github.com/${COMMENTS_REPO}/issues`} target="_blank" rel="noreferrer">
			查看讨论
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
		</a>
	</div>

	<div class="comment-stage">
		{commentsReady ? (
			<div
				class="comment-panel"
				data-utterances-root
				data-repo={COMMENTS_REPO}
				data-issue-term={COMMENTS_ISSUE_TERM}
				data-label={COMMENTS_LABEL}
				data-title={title}
			>
				<div class="comment-loading" aria-live="polite">
					<span aria-hidden="true"></span>
					正在唤醒评论区
				</div>
			</div>
		) : (
			<div class="comment-panel comment-setup">
				<h3>评论区还没有启用</h3>
				<p>请先在 <code>src/consts.ts</code> 里填写评论仓库配置，然后重新部署。</p>
			</div>
		)}
	</div>
</section>

<script>
	const getUtterancesTheme = () => document.documentElement.dataset.theme === 'dark' ? 'github-dark' : 'github-light';

	const updateUtterancesTheme = () => {
		document.querySelectorAll<HTMLIFrameElement>('iframe.utterances-frame').forEach((frame) => {
			frame.contentWindow?.postMessage({ type: 'set-theme', theme: getUtterancesTheme() }, 'https://utteranc.es');
		});
	};

	const loadUtterances = (root: HTMLElement) => {
		if (root.dataset.loaded === 'true') return;
		root.dataset.loaded = 'true';
		root.replaceChildren();

		const script = document.createElement('script');
		script.src = 'https://utteranc.es/client.js';
		script.async = true;
		script.crossOrigin = 'anonymous';
		script.setAttribute('repo', root.dataset.repo ?? '');
		script.setAttribute('issue-term', root.dataset.issueTerm ?? 'pathname');
		script.setAttribute('label', root.dataset.label ?? 'blog-comment');
		script.setAttribute('theme', getUtterancesTheme());
		script.setAttribute('crossorigin', 'anonymous');
		root.append(script);
	};

	const setupComments = () => {
		document.querySelectorAll<HTMLElement>('[data-utterances-root]').forEach((root) => {
			if (root.dataset.observed === 'true') return;
			root.dataset.observed = 'true';

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(([entry]) => {
					if (!entry?.isIntersecting) return;
					observer.disconnect();
					loadUtterances(root);
				}, { rootMargin: '420px 0px' });
				observer.observe(root);
				document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
				return;
			}

			window.requestAnimationFrame(() => {
				loadUtterances(root);
			});
		});
	};

	if (document.documentElement.dataset.utterancesThemeObserver !== 'true') {
		document.documentElement.dataset.utterancesThemeObserver = 'true';
		const themeObserver = new MutationObserver(updateUtterancesTheme);
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	}

	setupComments();
	document.addEventListener('astro:page-load', setupComments);
</script>

<style>
	.comment-card { position: relative; overflow: hidden; padding: clamp(1.1rem, 2.6vw, 1.75rem); border: 1px solid var(--line); border-radius: var(--radius-card); background: linear-gradient(145deg, color-mix(in srgb, var(--surface) 94%, transparent), color-mix(in srgb, var(--surface-lilac) 36%, var(--surface))); box-shadow: var(--shadow); isolation: isolate; }
	.comment-orb { position: absolute; z-index: -1; right: -7rem; top: -8rem; width: 17rem; aspect-ratio: 1; border-radius: 999px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%); filter: blur(3px); opacity: .68; pointer-events: none; }
	.comment-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--line) 56%, transparent); }
	.comment-heading h2 { margin: 0; font-size: clamp(1.45rem, 2vw, 1.9rem); letter-spacing: -.03em; }
	.comment-heading p { margin: .35rem 0 0; color: var(--muted); font-size: .86rem; line-height: 1.7; }
	.comment-heading a { display: inline-flex; flex: none; align-items: center; gap: .22rem; color: var(--accent-ink); font-size: .8rem; font-weight: 760; text-decoration: none; }
	.comment-heading a:hover { text-decoration: underline; text-underline-offset: .25em; }
	.comment-heading svg { width: .92rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
	.comment-stage { max-width: 78rem; margin: 1rem auto 0; padding: clamp(.65rem, 1.4vw, .9rem); border-radius: 1rem; background: color-mix(in srgb, var(--paper) 58%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 42%, transparent); }
	.comment-panel { overflow: hidden; min-height: 12rem; padding: clamp(.5rem, 1.2vw, .72rem); border: 1px solid color-mix(in srgb, var(--line) 52%, transparent); border-radius: .82rem; background: #0d1117; box-shadow: 0 .8rem 2rem color-mix(in srgb, var(--ink) 7%, transparent); isolation: isolate; }
	:global([data-theme='light']) .comment-panel { background: #ffffff; }
	.comment-panel[data-loaded='true'] { padding: 0; border-color: color-mix(in srgb, var(--line) 42%, transparent); background: #0d1117; }
	:global([data-theme='light']) .comment-panel[data-loaded='true'] { background: #ffffff; }
	.comment-loading { display: inline-flex; align-items: center; gap: .62rem; color: var(--muted); font-size: .82rem; font-weight: 680; }
	.comment-loading span { width: .66rem; height: .66rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 .38rem color-mix(in srgb, var(--accent) 14%, transparent); animation: comment-pulse 1.25s cubic-bezier(.22, 1, .36, 1) infinite; }
	.comment-setup h3 { margin: 0; font-size: 1rem; }
	.comment-setup p { margin: .45rem 0 0; color: var(--muted); font-size: .84rem; line-height: 1.8; }
	.comment-setup code { padding: .12rem .34rem; border-radius: .35rem; background: var(--paper-deep); color: var(--ink); font-size: .86em; }
	:global(.utterances) { width: calc(100% + 7.2rem) !important; max-width: calc(100% + 7.2rem) !important; margin: -2.65rem -1.55rem -1.35rem -5.65rem !important; }
	:global(.utterances-frame) { display: block; border-radius: .65rem; background: #0d1117; color-scheme: light dark; }
	:global([data-theme='light'] .utterances-frame) { background: #ffffff; }

	@keyframes comment-pulse {
		0%, 100% { opacity: .65; transform: scale(.88); }
		50% { opacity: 1; transform: scale(1); }
	}

	@media (max-width: 560px) {
		.comment-heading { display: grid; align-items: start; }
		.comment-card { padding: 1rem; border-radius: 1.15rem; }
		.comment-stage { padding: .5rem; }
		.comment-panel { padding: .5rem; border-radius: .85rem; }
		:global(.utterances) { width: calc(100% + 5.4rem) !important; max-width: calc(100% + 5.4rem) !important; margin: -2.45rem -1.15rem -1.15rem -4.25rem !important; }
	}

	@media (prefers-reduced-motion: reduce) {
		.comment-loading span { animation: none; }
	}
</style>
