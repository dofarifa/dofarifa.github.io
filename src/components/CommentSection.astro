---
import { COMMENTS_ENABLED, TWIKOO_ENV_ID, TWIKOO_REGION } from '../consts';

interface Props {
	title: string;
}

const { title } = Astro.props;
const hasTwikoo = COMMENTS_ENABLED && Boolean(TWIKOO_ENV_ID);
---

<section class="comment-section" aria-labelledby="comment-title">
	<div class="comment-divider" aria-hidden="true">
		<span>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="m4 20 6.9-6.9M4 4l6.9 6.9M20 4 4 20M20 20 4 4" />
				<circle cx="7" cy="7" r="2.2" />
				<circle cx="7" cy="17" r="2.2" />
			</svg>
		</span>
	</div>

	<div class="comment-heading">
		<div>
			<h2 id="comment-title">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 14a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v7Z" /></svg>
				评论
			</h2>
		</div>
		<p>匿名评论 · 隐私政策</p>
	</div>

	<div class="comment-card">
		<div
			class="twikoo-root"
			data-twikoo-root
			data-env-id={TWIKOO_ENV_ID}
			data-region={TWIKOO_REGION}
			data-title={title}
			data-enabled={String(hasTwikoo)}
		>
			<div class="comment-preview" data-preview-state={hasTwikoo ? 'loading' : 'setup'} aria-label="评论区预览">
				<div class="comment-avatar" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M12 12.25a4.35 4.35 0 1 0 0-8.7 4.35 4.35 0 0 0 0 8.7Zm-7.35 7.25a7.7 7.7 0 0 1 14.7 0" /></svg>
				</div>
				<div class="comment-preview-main">
					<div class="comment-form-row">
						<label class="comment-field">
							<strong>昵称</strong>
							<input disabled placeholder="必填" />
						</label>
						<label class="comment-field">
							<strong>邮箱</strong>
							<input disabled placeholder="必填" />
						</label>
						<label class="comment-field">
							<strong>网址</strong>
							<input disabled placeholder="选填" />
						</label>
					</div>

					<label class="comment-textarea">
						<span>0/500</span>
						<textarea disabled placeholder={hasTwikoo ? '写下你的想法。' : '配置 Twikoo 后，就可以在这里留下评论。'}></textarea>
					</label>

					<div class="comment-actions">
						<span class="comment-tool" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM8 10h.01M16 10h.01M8.5 15.2a5.3 5.3 0 0 0 7 0" /></svg>
						</span>
						<div>
							<span class="comment-markdown">M↓</span>
							<button class="comment-submit comment-submit-ghost" disabled>预览</button>
							<button class="comment-submit" disabled>发送</button>
						</div>
					</div>

					<div class="comment-empty">
						<p>{hasTwikoo ? '评论区正在准备' : '没有评论'}</p>
					</div>

					<p class="comment-powered">Powered by Twikoo v1.7.20</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const TWIKOO_OPTIONS = { timeout: 12000 };

	type TwikooClient = {
		init: (options: {
			envId: string;
			el: string;
			region?: string;
			path?: string;
			lang?: string;
			timeout?: number;
		}) => Promise<void> | void;
	};
	type TwikooInit = TwikooClient['init'];
	type TwikooWindow = Window & {
		__twikooClientPromise?: Promise<TwikooClient>;
		__twikooCommentsListenersReady?: boolean;
		__twikooRootIndex?: number;
	};

	const twikooState = window as TwikooWindow;

	const isObject = (value: unknown): value is Record<string, unknown> => typeof value === 'object' && value !== null;
	const hasInit = (value: unknown): value is TwikooClient => {
		return isObject(value) && typeof value.init === 'function';
	};

	const normalizeTwikooClient = (candidate: unknown): TwikooClient => {
		if (typeof candidate === 'function') return { init: candidate as TwikooInit };

		if (hasInit(candidate)) return candidate;

		const nestedDefault = isObject(candidate) ? candidate['default'] : undefined;
		if (typeof nestedDefault === 'function') return { init: nestedDefault as TwikooInit };
		if (hasInit(nestedDefault)) return nestedDefault;

		throw new Error('Twikoo client export is invalid');
	};

	const getTwikooClient = () => {
		twikooState.__twikooClientPromise ??= import('twikoo').then((module) => normalizeTwikooClient(module));
		return twikooState.__twikooClientPromise;
	};

	const afterLayoutSettles = () =>
		new Promise<void>((resolve) => {
			window.requestAnimationFrame(() => window.requestAnimationFrame(resolve));
		});

	const ensureRootId = (root: HTMLElement) => {
		if (root.id) return root.id;

		twikooState.__twikooRootIndex = (twikooState.__twikooRootIndex ?? 0) + 1;
		root.id = `twikoo-comments-${twikooState.__twikooRootIndex}`;
		return root.id;
	};

	const loadTwikoo = async (root: HTMLElement) => {
		if (root.dataset.loaded === 'true' || root.dataset.loaded === 'loading' || root.dataset.enabled !== 'true') return;

		const envId = root.dataset.envId;
		if (!envId) return;

		root.dataset.loaded = 'loading';
		root.dataset.stale = 'false';
		const rootId = ensureRootId(root);

		try {
			const twikooClient = await getTwikooClient();
			await afterLayoutSettles();
			if (!root.isConnected || root.dataset.stale === 'true') return;

			root.replaceChildren();
			await twikooClient.init({
				envId,
				el: `#${rootId}`,
				region: root.dataset.region || undefined,
				path: window.location.pathname,
				lang: 'zh-CN',
				...TWIKOO_OPTIONS,
			});
			root.dataset.loaded = 'true';
		} catch (error) {
			console.error('Twikoo failed to load:', error);
			if (!root.isConnected || root.dataset.stale === 'true') return;

			root.dataset.loaded = 'false';
			root.innerHTML = '<p class="comment-fallback">评论暂时没有连上。刷新页面，或稍后再试。</p>';
		}
	};

	const teardownComments = () => {
		document.querySelectorAll<HTMLElement>('[data-twikoo-root]').forEach((root) => {
			root.dataset.stale = 'true';
			if (root.dataset.loaded === 'loading') root.dataset.loaded = 'false';
		});
	};

	const setupComments = () => {
		document.querySelectorAll<HTMLElement>('[data-twikoo-root]').forEach((root) => {
			if (root.dataset.observed === 'true') return;
			root.dataset.observed = 'true';
			window.requestAnimationFrame(() => void loadTwikoo(root));
		});
	};

	void getTwikooClient();
	setupComments();
	if (!twikooState.__twikooCommentsListenersReady) {
		twikooState.__twikooCommentsListenersReady = true;
		document.addEventListener('astro:before-swap', teardownComments);
		document.addEventListener('astro:page-load', setupComments);
	}
</script>

<style>
	.comment-section { position: relative; display: grid; gap: 1.15rem; }
	.comment-divider { display: flex; align-items: center; gap: .75rem; color: color-mix(in srgb, var(--muted) 84%, transparent); }
	.comment-divider::before,
	.comment-divider::after { height: 0; flex: 1; border-top: 4px dotted color-mix(in srgb, var(--muted) 50%, transparent); content: ""; }
	.comment-divider span { display: grid; width: 2.2rem; height: 2.2rem; place-items: center; flex: none; border-radius: 50%; background: color-mix(in srgb, var(--paper) 74%, transparent); }
	.comment-divider svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
	.comment-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.comment-heading h2 { display: inline-flex; align-items: center; gap: .42rem; margin: 0; color: var(--ink); font-size: 1.05rem; line-height: 1.2; letter-spacing: -.015em; }
	.comment-heading h2 svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.9; }
	.comment-heading p { margin: 0; color: color-mix(in srgb, var(--muted) 88%, var(--accent-ink)); font-size: .78rem; font-weight: 680; }
	.comment-card { position: relative; overflow: hidden; padding: clamp(1.15rem, 2.1vw, 1.55rem); border: 1px solid color-mix(in srgb, var(--line) 84%, transparent); border-radius: 1.1rem; background: linear-gradient(145deg, color-mix(in srgb, var(--surface) 78%, transparent), color-mix(in srgb, var(--surface-blue) 22%, var(--surface))); box-shadow: 0 1.15rem 3rem color-mix(in srgb, var(--ink) 13%, transparent); }
	.comment-card::before { position: absolute; inset: auto -5rem -6rem auto; width: 14rem; height: 14rem; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%); content: ""; filter: blur(2px); pointer-events: none; }
	.twikoo-root { position: relative; z-index: 1; min-height: 15rem; color: var(--ink); }
	.comment-preview { display: grid; grid-template-columns: 2.7rem minmax(0, 1fr); gap: .78rem; min-height: 15rem; }
	.comment-preview[data-preview-state='loading'] { animation: comment-soft-arrival .7s cubic-bezier(.16, 1, .3, 1) both; }
	.comment-avatar { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--ink) 10%, transparent); color: color-mix(in srgb, var(--muted) 86%, var(--ink)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 60%, transparent); }
	.comment-avatar svg { width: 1.55rem; height: 1.55rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.85; }
	.comment-preview-main { display: grid; min-width: 0; gap: .62rem; }
	.comment-textarea { position: relative; display: block; }
	.comment-textarea textarea { display: block; width: 100%; min-height: 8.7rem; resize: vertical; border: 1px solid color-mix(in srgb, var(--line) 85%, transparent); border-radius: .72rem; background: color-mix(in srgb, var(--paper) 72%, transparent); color: var(--ink); font: inherit; line-height: 1.7; padding: 1rem 1rem 1.8rem; outline: none; box-shadow: inset 0 1px 0 color-mix(in srgb, white 5%, transparent); }
	.comment-textarea textarea::placeholder { color: color-mix(in srgb, var(--muted) 76%, transparent); }
	.comment-textarea span { position: absolute; right: .75rem; bottom: .55rem; color: color-mix(in srgb, var(--muted) 84%, transparent); font-size: .72rem; pointer-events: none; }
	.comment-form-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; }
	.comment-field { display: grid; grid-template-columns: auto 1fr; overflow: hidden; min-height: 2.35rem; border: 1px solid color-mix(in srgb, var(--line) 88%, transparent); border-radius: .62rem; background: color-mix(in srgb, var(--paper) 55%, transparent); }
	.comment-field strong { display: grid; place-items: center; min-width: 4.25rem; padding: 0 .75rem; background: color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink); font-size: .78rem; font-weight: 820; }
	.comment-field input { min-width: 0; border: 0; background: transparent; color: var(--ink); font: inherit; padding: 0 .75rem; outline: none; }
	.comment-field input::placeholder { color: color-mix(in srgb, var(--muted) 78%, transparent); }
	.comment-actions { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 2.5rem; }
	.comment-actions > div { display: inline-flex; align-items: center; gap: .5rem; }
	.comment-tool { display: inline-grid; width: 1.75rem; height: 1.75rem; place-items: center; color: color-mix(in srgb, var(--muted) 92%, var(--accent-ink)); }
	.comment-tool svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.comment-markdown { color: color-mix(in srgb, var(--muted) 88%, var(--ink)); font-size: .74rem; font-weight: 820; }
	.comment-submit { min-width: 4.1rem; border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent); border-radius: .46rem; background: color-mix(in srgb, var(--accent) 78%, var(--paper)); color: var(--accent-contrast); font: inherit; font-size: .78rem; font-weight: 760; cursor: not-allowed; }
	.comment-submit-ghost { background: color-mix(in srgb, var(--paper) 58%, transparent); color: var(--ink); border-color: color-mix(in srgb, var(--line) 86%, transparent); }
	.comment-empty { display: grid; gap: .82rem; justify-items: center; min-height: 7rem; align-content: center; color: var(--muted); }
	.comment-empty p { margin: 0; font-size: .9rem; }
	.comment-refresh { justify-self: end; width: 2rem; height: 2rem; margin-bottom: .1rem; border: 0; background: transparent; color: color-mix(in srgb, var(--muted) 88%, transparent); cursor: not-allowed; }
	.comment-refresh svg { width: 1.18rem; height: 1.18rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
	.comment-more { width: 100%; min-height: 2.7rem; border: 1px solid color-mix(in srgb, var(--line) 92%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--paper) 38%, transparent); color: color-mix(in srgb, var(--muted) 92%, var(--ink)); font: inherit; font-size: .78rem; letter-spacing: .2em; cursor: not-allowed; }
	.comment-powered { margin: .08rem 0 0; color: color-mix(in srgb, var(--muted) 80%, transparent); font-size: .72rem; text-align: right; }
	.comment-loading,
	.comment-fallback { display: inline-flex; align-items: center; gap: .62rem; color: var(--muted); font-size: .84rem; font-weight: 680; }
	.comment-loading span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 .38rem color-mix(in srgb, var(--accent) 14%, transparent); animation: comment-pulse 1.25s cubic-bezier(.22, 1, .36, 1) infinite; }
	.comment-fallback { margin: 0; padding: 1rem; }
	:global(.twikoo-root) { color: var(--ink); font-size: .88rem; }
	:global(.twikoo-root a),
	:global(.twikoo-root .tk-action-link),
	:global(.twikoo-root .tk-nick-link:hover),
	:global(.twikoo-root .tk-submit-action-icon:hover) { color: var(--accent-ink); }
	:global(.twikoo-root .tk-submit) { color: var(--ink); animation: comment-soft-arrival .62s cubic-bezier(.16, 1, .3, 1) both; }
	:global(.twikoo-root .tk-avatar) { width: 2.5rem; height: 2.5rem; flex: 0 0 2.5rem; overflow: hidden; border-radius: 50%; }
	:global(.twikoo-root .tk-submit .tk-avatar) { display: grid; width: 2.7rem; height: 2.7rem; flex-basis: 2.7rem; place-items: center; margin-right: .78rem; background: color-mix(in srgb, var(--ink) 10%, transparent); color: color-mix(in srgb, var(--muted) 86%, var(--ink)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 60%, transparent); }
	:global(.twikoo-root .tk-comment .tk-submit .tk-avatar),
	:global(.twikoo-root .tk-replies .tk-avatar) { width: 1.6rem; height: 1.6rem; flex-basis: 1.6rem; }
	:global(.twikoo-root .tk-avatar .tk-avatar-img) { color: currentColor; }
	:global(.twikoo-root .tk-avatar img.tk-avatar-img) { display: block; width: 100%; height: 100%; max-width: none; border-radius: inherit; object-fit: cover; }
	:global(.twikoo-root .tk-avatar svg.tk-avatar-img) { width: 1.65rem; height: 1.65rem; }
	:global(.twikoo-root .tk-main) { min-width: 0; }
	:global(.twikoo-root .tk-meta-input) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; margin: 0 0 .62rem; }
	:global(.twikoo-root .tk-meta-input .el-input) { width: 100% !important; margin: 0 !important; }
	:global(.twikoo-root .el-input-group__prepend) { min-width: 4.25rem; padding: 0 .8rem; border-color: color-mix(in srgb, var(--line) 88%, transparent); background: color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink); font-size: .78rem; font-weight: 820; text-align: center; }
	:global(.twikoo-root .el-input__inner),
	:global(.twikoo-root .el-textarea__inner) { border-color: color-mix(in srgb, var(--line) 88%, transparent); background: color-mix(in srgb, var(--paper) 72%, transparent); color: var(--ink); box-shadow: inset 0 1px 0 color-mix(in srgb, white 5%, transparent); }
	:global(.twikoo-root .el-input__inner) { height: 2.35rem; line-height: 2.35rem; }
	:global(.twikoo-root .el-textarea__inner) { min-height: 8.7rem !important; border-radius: .72rem; line-height: 1.7; }
	:global(.twikoo-root .el-input__inner::placeholder),
	:global(.twikoo-root .el-textarea__inner::placeholder) { color: color-mix(in srgb, var(--muted) 72%, transparent); }
	:global(.twikoo-root .el-input__inner:focus),
	:global(.twikoo-root .el-textarea__inner:focus) { border-color: color-mix(in srgb, var(--accent) 78%, white); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
	:global(.twikoo-root .tk-row.actions) { margin: .82rem 0 1rem 3.48rem; align-items: center; }
	:global(.twikoo-root .tk-submit-action-icon),
	:global(.twikoo-root .tk-icon.__comments) { display: inline-grid; width: 1.75rem; height: 1.75rem; place-items: center; flex: 0 0 1.75rem; color: color-mix(in srgb, var(--muted) 92%, var(--accent-ink)); line-height: 1; transition: color .18s ease, transform .18s ease; }
	:global(.twikoo-root .tk-icon.__comments) { width: .95rem; height: .95rem; flex-basis: .95rem; color: var(--accent-ink); }
	:global(.twikoo-root .tk-submit-action-icon svg),
	:global(.twikoo-root .tk-icon.__comments svg) { display: block; width: 100%; height: 100%; max-width: none; }
	:global(.twikoo-root .tk-submit-action-icon:hover) { transform: translateY(-1px); }
	:global(.twikoo-root .OwO) { position: relative; }
	:global(.twikoo-root .OwO .OwO-body) { right: auto; width: min(31rem, calc(100vw - 2rem)); max-width: min(31rem, 100%); border-color: color-mix(in srgb, var(--line) 88%, transparent); border-radius: .78rem; background: var(--surface); color: var(--ink); box-shadow: 0 .9rem 2.2rem color-mix(in srgb, var(--ink) 18%, transparent); }
	:global(.twikoo-root .OwO .OwO-items) { max-height: 14rem; padding: .55rem; overflow: auto; }
	:global(.twikoo-root .OwO .OwO-items-image .OwO-item) { width: 14%; }
	:global(.twikoo-root .OwO .OwO-items-image .OwO-item img),
	:global(.twikoo-root .tk-owo-emotion) { width: 2.35rem; height: 2.35rem; max-width: 2.35rem; max-height: 2.35rem; object-fit: contain; vertical-align: middle; }
	:global(.twikoo-root .tk-content img) { width: auto; max-width: min(18rem, 100%); max-height: 18rem; object-fit: contain; }
	:global(.twikoo-root .el-button) { border-radius: .48rem; border-color: color-mix(in srgb, var(--line) 88%, transparent); background: color-mix(in srgb, var(--paper) 58%, transparent); color: var(--ink); font-size: .78rem; font-weight: 760; }
	:global(.twikoo-root .el-button--primary) { border-color: color-mix(in srgb, var(--accent) 42%, transparent); background: color-mix(in srgb, var(--accent) 78%, var(--paper)); color: var(--accent-contrast); }
	:global(.twikoo-root .el-button--primary:hover),
	:global(.twikoo-root .el-button--primary:focus) { border-color: var(--accent); background: var(--accent); color: var(--accent-contrast); }
	:global(.twikoo-root .el-button.is-disabled),
	:global(.twikoo-root .el-button.is-disabled:hover) { border-color: color-mix(in srgb, var(--line) 68%, transparent); background: color-mix(in srgb, var(--muted) 20%, transparent); color: color-mix(in srgb, var(--muted) 82%, transparent); }
	:global(.twikoo-root .tk-comments-title) { margin: 1.2rem 0 .75rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--line) 62%, transparent); color: var(--ink); font-size: 1rem; }
	:global(.twikoo-root .tk-comments-container) { color: var(--ink); }
	:global(.twikoo-root .tk-comments-no) { min-height: 7rem; color: color-mix(in srgb, var(--ink) 88%, var(--muted)); font-size: 1.08rem; }
	:global(.twikoo-root .tk-comments-error) { color: #ff9ca9; }
	:global(.twikoo-root .tk-extras),
	:global(.twikoo-root .tk-footer) { color: color-mix(in srgb, var(--muted) 84%, transparent); }
	:global(.twikoo-root .tk-footer) { margin-top: 1rem; font-size: .72rem; }
	:global(.twikoo-root .tk-content),
	:global(.twikoo-root .tk-preview-container) { color: var(--ink); }

	@keyframes comment-pulse {
		0%, 100% { opacity: .62; transform: scale(.86); }
		50% { opacity: 1; transform: scale(1); }
	}
	@keyframes comment-soft-arrival {
		from { opacity: .75; filter: blur(5px); transform: translateY(6px); }
		to { opacity: 1; filter: blur(0); transform: translateY(0); }
	}

	@media (max-width: 760px) {
		.comment-form-row { grid-template-columns: 1fr; }
		.comment-preview { grid-template-columns: 1fr; }
		.comment-avatar { display: none; }
		.comment-heading { align-items: flex-start; flex-direction: column; gap: .38rem; }
		.comment-card { padding: .75rem; }
		:global(.twikoo-root .tk-meta-input) { grid-template-columns: 1fr; }
		:global(.twikoo-root .tk-submit .tk-avatar) { display: none; }
		:global(.twikoo-root .tk-row.actions) { margin-left: 0; flex-wrap: wrap; gap: .55rem; }
		:global(.twikoo-root .OwO .OwO-body) { left: 0; width: min(19.5rem, calc(100vw - 2.5rem)); max-width: calc(100vw - 2.5rem); }
		:global(.twikoo-root .OwO .OwO-items > .OwO-item) { width: 25%; min-height: 3rem; }
		:global(.twikoo-root .tk-content img) { max-width: min(14rem, 100%); max-height: 14rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.comment-loading span { animation: none; }
		.comment-preview[data-preview-state='loading'],
		:global(.twikoo-root .tk-submit) { animation: none; }
	}
</style>
