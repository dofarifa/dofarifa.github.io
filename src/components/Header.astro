---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { HOME_BANNER_POSTER, HOME_BANNER_VIDEO, SITE_ICON, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const searchPosts = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	href: `/blog/${post.id}/`,
	date: post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }),
	tags: post.data.tags,
}));
const randomPostUrls = searchPosts.map((post) => post.href);
const isHome = Astro.url.pathname === '/';
const homeMediaAssets = {
	poster: HOME_BANNER_POSTER,
	video: HOME_BANNER_VIDEO,
};
---

<header class:list={['site-header', { 'is-home': isHome }]}>
	<nav class="shell nav" aria-label="主导航">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span class="brand-mark" aria-hidden="true"><Image src={SITE_ICON} alt="" width={68} height={68} format="webp" quality={80} /></span>
			<span>{SITE_TITLE}</span>
		</a>

		<div class="nav-links desktop-nav">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/music">歌单</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>

		<div class="header-tools">
			<button class="tool-button random-button" type="button" data-random-post aria-label="随机阅读一篇文章" title="随机阅读">
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="8.3" cy="8.3" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="15.7" cy="15.7" r="1" /></svg>
			</button>
			<button class="tool-button" type="button" data-search-open aria-label="搜索文章" title="搜索文章">
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.2 4.2" /></svg>
			</button>
			<ThemeToggle />
			<a class="tool-button rss-link" href="/rss/" aria-label="RSS 订阅" title="RSS 订阅">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9Zm1.5 7A2.5 2.5 0 1 1 4 18.5 2.5 2.5 0 0 1 6.5 16Z" /></svg>
			</a>

			<details class="mobile-menu">
				<summary aria-label="打开导航菜单">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
				</summary>
				<div class="mobile-menu-panel">
					<HeaderLink href="/">首页</HeaderLink>
					<HeaderLink href="/blog">文章</HeaderLink>
					<HeaderLink href="/music">歌单</HeaderLink>
					<HeaderLink href="/about">关于</HeaderLink>
					<a href="/rss/">RSS 订阅</a>
				</div>
			</details>
		</div>
	</nav>

</header>

<SearchDialog posts={searchPosts} />
<script type="application/json" id="random-post-urls" set:html={JSON.stringify(randomPostUrls)} />
<script type="application/json" id="home-media-assets" set:html={JSON.stringify(homeMediaAssets)} />

<script>
	import { navigate } from 'astro:transitions/client';

	const setupHeader = () => {
		const randomPostData = document.querySelector<HTMLScriptElement>('#random-post-urls');
		const postUrls: string[] = randomPostData ? JSON.parse(randomPostData.textContent ?? '[]') : [];

		document.querySelectorAll<HTMLButtonElement>('[data-random-post]').forEach((button) => {
			if (button.dataset.initialized === 'true') return;
			button.dataset.initialized = 'true';
			button.addEventListener('click', () => {
				if (!postUrls.length) return;
				void navigate(postUrls[Math.floor(Math.random() * postUrls.length)]);
			});
		});

		const warmupHomeMedia = () => {
			const root = document.documentElement;
			if (root.dataset.homeMediaWarmup === 'true' || location.pathname === '/') return;
			const data = document.querySelector<HTMLScriptElement>('#home-media-assets');
			if (!data?.textContent) return;
			const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
			if (connection?.saveData || /2g/.test(connection?.effectiveType ?? '')) return;
			if (window.matchMedia('(max-width: 760px)').matches) return;

			root.dataset.homeMediaWarmup = 'true';
			const { poster, video } = JSON.parse(data.textContent) as { poster?: string; video?: string };
			const addPrefetch = (href: string, as: 'image' | 'video') => {
				if (!href || document.head.querySelector(`link[data-home-media-prefetch][href="${href}"]`)) return;
				const link = document.createElement('link');
				link.rel = 'prefetch';
				link.as = as;
				link.href = href;
				link.dataset.homeMediaPrefetch = 'true';
				document.head.append(link);
			};
			const warmPoster = () => {
				if (!poster) return;
				addPrefetch(poster, 'image');
				const image = new Image();
				image.decoding = 'async';
				image.src = poster;
			};
			const warmVideo = () => {
				if (video && !window.matchMedia('(hover: none), (pointer: coarse)').matches) addPrefetch(video, 'video');
			};
			window.requestAnimationFrame(warmPoster);
			const idle = (window as Window & { requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number }).requestIdleCallback;
			if (idle) idle(warmVideo, { timeout: 1800 });
			else window.setTimeout(warmVideo, 1200);
		};

		warmupHomeMedia();
	};

	document.addEventListener('click', (event) => {
		document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open]').forEach((menu) => {
			if (!menu.contains(event.target as Node)) menu.removeAttribute('open');
		});
	});
	setupHeader();
	document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
	.site-header {
		--header-bg-start: color-mix(in srgb, var(--paper) 82%, transparent);
		--header-bg-mid: color-mix(in srgb, var(--paper) 52%, transparent);
		--header-bg-end: color-mix(in srgb, var(--paper) 0%, transparent);
		--nav-row-height: 3.3rem;
		--nav-control-size: 2.38rem;
		position: sticky;
		top: 0;
		z-index: 30;
		padding-block: .34rem .86rem;
		color: var(--header-ink, var(--ink));
	}
	.site-header::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(180deg, var(--header-bg-start), var(--header-bg-mid) 58%, color-mix(in srgb, var(--header-bg-mid) 34%, transparent) 78%, var(--header-bg-end));
		content: "";
		pointer-events: none;
		backdrop-filter: blur(18px) saturate(1.04);
		mask-image: linear-gradient(#000 74%, transparent);
	}
	.site-header.is-home { margin-bottom: -4.85rem; }
	:global([data-theme='dark']) .site-header {
		--header-bg-start: rgba(17, 15, 25, .58);
		--header-bg-mid: rgba(17, 15, 25, .36);
		--header-bg-end: rgba(17, 15, 25, 0);
		--header-brand-color: rgba(245, 242, 255, .9);
		--header-link-color: rgba(245, 242, 255, .7);
		--header-link-hover-color: rgba(255, 255, 255, .96);
		--header-link-active-color: rgba(255, 255, 255, .96);
		--header-link-indicator: color-mix(in srgb, var(--accent) 76%, white 12%);
		--header-link-indicator-opacity: .72;
		--header-tool-color: rgba(245, 242, 255, .68);
		--header-tool-hover-color: rgba(255, 255, 255, .96);
		--header-tool-hover-bg: rgba(255, 255, 255, .07);
		--header-mark-bg: rgba(255, 255, 255, .08);
		--header-mark-shadow: 0 .7rem 1.8rem rgba(0, 0, 0, .18);
	}
	.nav {
		display: grid;
		min-height: var(--nav-row-height);
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: clamp(.9rem, 2.4vw, 2rem);
		padding-inline: clamp(.25rem, 1.2vw, .8rem);
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}
	.brand { display: inline-flex; width: fit-content; align-items: center; gap: .76rem; color: var(--header-brand-color, var(--ink)); font-family: var(--font-display); font-size: clamp(1.14rem, 1.4vw, 1.24rem); font-weight: 840; letter-spacing: -.012em; line-height: 1; text-decoration: none; }
	.brand-mark { display: grid; overflow: hidden; width: 2.15rem; height: 2.15rem; place-items: center; border-radius: .75rem; background: var(--header-mark-bg, color-mix(in srgb, var(--accent-soft) 72%, transparent)); box-shadow: var(--header-mark-shadow, none); }
	.brand-mark img { width: 100%; height: 100%; object-fit: cover; }
	.nav-links { display: flex; min-height: var(--nav-control-size); align-items: center; gap: clamp(.85rem, 2.3vw, 1.6rem); }
	.header-tools { display: flex; min-height: var(--nav-control-size); align-items: center; justify-content: flex-end; justify-self: end; gap: .16rem; }
	.tool-button, .mobile-menu summary {
		display: grid;
		width: var(--nav-control-size);
		height: var(--nav-control-size);
		padding: 0;
		border: 0;
		place-items: center;
		border-radius: 50%;
		background: transparent;
		color: var(--header-tool-color, var(--muted));
		cursor: pointer;
		transition: background-color .2s ease, color .2s ease, transform .2s ease;
	}
	.tool-button:hover, .mobile-menu summary:hover { background: var(--header-tool-hover-bg, color-mix(in srgb, var(--accent-soft) 48%, transparent)); color: var(--header-tool-hover-color, var(--accent-ink)); transform: translateY(-.5px); }
	.tool-button svg, .mobile-menu summary svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.random-button svg circle { fill: currentColor; stroke: none; }
	.rss-link svg { fill: currentColor; stroke: none; }
	.mobile-menu { position: relative; display: none; }
	.mobile-menu summary { list-style: none; }
	.mobile-menu summary::-webkit-details-marker { display: none; }
	.mobile-menu-panel { position: absolute; top: calc(100% + .75rem); right: 0; display: grid; width: 11rem; gap: .2rem; padding: .6rem; border: 1px solid var(--line); border-radius: var(--radius-small); background: var(--surface); box-shadow: var(--shadow); }
	.mobile-menu-panel :global(a) { display: flex; min-height: 2.65rem; align-items: center; padding: .6rem .8rem; border-radius: .7rem; color: var(--muted); font-size: .88rem; font-weight: 600; line-height: 1; text-decoration: none; }
	.mobile-menu-panel :global(a:hover), .mobile-menu-panel :global(a.active) { background: var(--accent-soft); color: var(--accent-ink); }
	@media (max-width: 760px) {
		.site-header.is-home { margin-bottom: 0; }
		.nav { grid-template-columns: 1fr auto; }
		.desktop-nav, .rss-link { display: none; }
		.mobile-menu { display: block; }
	}
	@media (max-width: 520px) {
		.site-header { --nav-row-height: 3.35rem; --nav-control-size: 2.4rem; padding-block: .38rem .72rem; }
		.nav { min-height: var(--nav-row-height); gap: .35rem; padding-inline: .55rem; }
		.header-tools { gap: 0; }
		.header-tools > .tool-button, .header-tools > :global(.theme-toggle), .mobile-menu summary { width: var(--nav-control-size); height: var(--nav-control-size); }
	}
</style>
