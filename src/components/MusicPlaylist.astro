---
import 'aplayer/dist/APlayer.min.css';
import { NETEASE_PLAYLIST_ID } from '../consts';

const playlistUrl = `https://music.163.com/#/playlist?id=${NETEASE_PLAYLIST_ID}`;
---

<details class="music-menu" data-music-menu data-playlist-id={NETEASE_PLAYLIST_ID}>
	<summary class="music-trigger" aria-label="打开我的网易云歌单" title="我的歌单">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M9 18V5l10-2v13" />
			<circle cx="6" cy="18" r="3" />
			<circle cx="16" cy="16" r="3" />
		</svg>
	</summary>

	<div class="music-panel">
		<div class="music-panel-head">
			<div>
				<h2>我的歌单</h2>
				<p>来自网易云音乐的收藏</p>
			</div>
			<a href={playlistUrl} target="_blank" rel="noreferrer" aria-label="在网易云音乐中打开歌单" title="在网易云音乐中打开">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M10 14 19 5M19 14v5H5V5h5" /></svg>
			</a>
		</div>

		<div class="music-player" data-music-player>
			<div class="music-status" data-music-status role="status">
				<span class="music-equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
				<span data-music-status-text>打开后加载歌单</span>
				<button type="button" data-music-retry hidden>重新加载</button>
			</div>
			<div data-music-host></div>
		</div>
	</div>
</details>

<script>
	type PlayerWindow = typeof window & { APlayer?: unknown };

	const waitForPlayer = (host: HTMLElement) => new Promise<void>((resolve, reject) => {
		const existingPlayer = host.querySelector('.aplayer');
		if (existingPlayer) {
			resolve();
			return;
		}

		const observer = new MutationObserver(() => {
			if (!host.querySelector('.aplayer')) return;
			window.clearTimeout(timeout);
			observer.disconnect();
			resolve();
		});
		const timeout = window.setTimeout(() => {
			observer.disconnect();
			reject(new Error('网易云歌单加载超时'));
		}, 30_000);

		observer.observe(host, { childList: true, subtree: true });
	});

	document.querySelectorAll<HTMLDetailsElement>('[data-music-menu]').forEach((menu) => {
		const playlistId = menu.dataset.playlistId;
		const host = menu.querySelector<HTMLElement>('[data-music-host]');
		const status = menu.querySelector<HTMLElement>('[data-music-status]');
		const statusText = menu.querySelector<HTMLElement>('[data-music-status-text]');
		const retry = menu.querySelector<HTMLButtonElement>('[data-music-retry]');
		let loading = false;
		let loaded = false;

		const loadPlaylist = async () => {
			if (!playlistId || !host || !status || !statusText || !retry || loading || loaded) return;

			loading = true;
			menu.dataset.state = 'loading';
			status.hidden = false;
			statusText.textContent = '正在读取网易云歌单';
			retry.hidden = true;
			host.replaceChildren();

			try {
				const playerWindow = window as PlayerWindow;
				if (!playerWindow.APlayer) {
					const aplayerModule = await import('aplayer');
					playerWindow.APlayer = aplayerModule.default;
				}
				if (!window.customElements.get('meting-js')) await import('meting/dist/Meting.min.js');

				const player = document.createElement('meting-js');
				player.setAttribute('server', 'netease');
				player.setAttribute('type', 'playlist');
				player.setAttribute('id', playlistId);
				player.setAttribute('autoplay', 'false');
				player.setAttribute('preload', 'none');
				player.setAttribute('loop', 'all');
				player.setAttribute('order', 'list');
				player.setAttribute('volume', '0.5');
				player.setAttribute('list-folded', 'false');
				player.setAttribute('list-max-height', '16rem');
				player.setAttribute('theme', '#6c5fc7');
				host.append(player);

				await waitForPlayer(host);
				loaded = true;
				menu.dataset.state = 'ready';
				status.hidden = true;
			} catch {
				menu.dataset.state = 'error';
				statusText.textContent = '歌单暂时没有加载成功';
				retry.hidden = false;
			} finally {
				loading = false;
			}
		};

		menu.addEventListener('toggle', () => {
			if (menu.open) loadPlaylist();
		});
		retry?.addEventListener('click', loadPlaylist);
	});

	document.addEventListener('click', (event) => {
		document.querySelectorAll<HTMLDetailsElement>('[data-music-menu][open]').forEach((menu) => {
			if (!menu.contains(event.target as Node)) menu.removeAttribute('open');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll<HTMLDetailsElement>('[data-music-menu][open]').forEach((menu) => menu.removeAttribute('open'));
	});
</script>

<style>
	.music-menu { position: relative; }
	.music-trigger {
		display: grid;
		width: 2.4rem;
		height: 2.4rem;
		padding: 0;
		border: 0;
		place-items: center;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		list-style: none;
		transition: background-color .2s ease, color .2s ease, transform .2s ease;
	}
	.music-trigger::-webkit-details-marker { display: none; }
	.music-trigger:hover, .music-menu[open] .music-trigger { background: var(--accent-soft); color: var(--accent-ink); transform: translateY(-1px); }
	.music-trigger svg, .music-panel-head svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.music-panel {
		position: absolute;
		top: calc(100% + .85rem);
		right: -5rem;
		width: min(25rem, calc(100vw - 2rem));
		padding: 1rem;
		border-radius: var(--radius-small);
		background: var(--surface);
		box-shadow: var(--shadow-raised);
	}
	.music-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: .15rem .2rem .85rem; }
	.music-panel-head h2 { margin: 0; font-size: 1rem; }
	.music-panel-head p { margin: .2rem 0 0; color: var(--muted); font-size: .72rem; line-height: 1.5; }
	.music-panel-head a { display: grid; width: 2rem; height: 2rem; flex: none; place-items: center; border-radius: 50%; color: var(--muted); }
	.music-panel-head a:hover { background: var(--accent-soft); color: var(--accent-ink); }
	.music-player { position: relative; min-height: 4.6rem; }
	.music-status { display: flex; min-height: 4.6rem; align-items: center; justify-content: center; gap: .65rem; color: var(--muted); font-size: .78rem; text-align: center; }
	.music-status[hidden] { display: none; }
	.music-status button { padding: .35rem .65rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--paper); color: var(--ink); cursor: pointer; font-size: .72rem; }
	.music-equalizer { display: inline-flex; height: 1rem; align-items: flex-end; gap: .14rem; }
	.music-equalizer i { width: .14rem; height: 45%; border-radius: .2rem; background: var(--accent); animation: music-level .8s cubic-bezier(.22, 1, .36, 1) infinite alternate; }
	.music-equalizer i:nth-child(2) { height: 90%; animation-delay: -.35s; }
	.music-equalizer i:nth-child(3) { height: 65%; animation-delay: -.15s; }
	.music-menu:not([data-state='loading']) .music-equalizer i { animation-play-state: paused; }
	.music-player :global(.aplayer) { margin: 0; background: transparent; box-shadow: none; color: var(--ink); font-family: var(--font-body); }
	.music-player :global(.aplayer .aplayer-info) { border-bottom-color: var(--line); }
	.music-player :global(.aplayer .aplayer-info .aplayer-music .aplayer-title) { color: var(--ink); font-size: .82rem; }
	.music-player :global(.aplayer .aplayer-info .aplayer-music .aplayer-author),
	.music-player :global(.aplayer .aplayer-time),
	.music-player :global(.aplayer .aplayer-list ol li .aplayer-list-author) { color: var(--muted); }
	.music-player :global(.aplayer .aplayer-list) { border-color: var(--line); }
	.music-player :global(.aplayer .aplayer-list ol li) { border-top-color: var(--line); color: var(--ink); }
	.music-player :global(.aplayer .aplayer-list ol li:hover),
	.music-player :global(.aplayer .aplayer-list ol li.aplayer-list-light) { background: var(--accent-soft); }
	.music-player :global(.aplayer .aplayer-list ol li .aplayer-list-index) { color: var(--muted); font-variant-numeric: tabular-nums; }
	.music-player :global(.aplayer .aplayer-icon path) { fill: currentColor; }
	@keyframes music-level { to { height: 100%; } }
	@media (max-width: 520px) {
		.music-trigger { width: 2.25rem; height: 2.25rem; }
		.music-panel { right: -4.6rem; padding: .85rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.music-equalizer i { animation: none; }
	}
</style>
