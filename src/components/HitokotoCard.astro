---
import { SITE_TAGLINE } from '../consts';
---

<div class="hitokoto-card" data-hitokoto-card transition:persist="site-hitokoto">
	<a class="hitokoto-content" data-hitokoto-link href="https://hitokoto.cn/" target="_blank" rel="noreferrer" aria-label={SITE_TAGLINE}>
		<span data-hitokoto-text aria-hidden="true">{SITE_TAGLINE}</span>
		<cite data-hitokoto-source>本站格言</cite>
	</a>
</div>

<script>
	interface HitokotoResponse {
		hitokoto?: unknown;
		from?: unknown;
		from_who?: unknown;
		uuid?: unknown;
	}

	const card = document.querySelector<HTMLElement>('[data-hitokoto-card]');
	const text = card?.querySelector<HTMLElement>('[data-hitokoto-text]');
	const source = card?.querySelector<HTMLElement>('[data-hitokoto-source]');
	const link = card?.querySelector<HTMLAnchorElement>('[data-hitokoto-link]');
	const endpoint = new URL('https://v1.hitokoto.cn/');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let requestInFlight = false;
	let typingToken = 0;

	['d', 'e', 'i', 'k'].forEach((category) => endpoint.searchParams.append('c', category));
	endpoint.searchParams.set('encode', 'json');
	endpoint.searchParams.set('charset', 'utf-8');
	endpoint.searchParams.set('min_length', '8');
	endpoint.searchParams.set('max_length', '28');

	const asText = (value: unknown) => typeof value === 'string' ? value.trim() : '';
	const typeSentence = (sentence: string) => {
		if (!card || !text) return;
		const token = ++typingToken;
		const characters = Array.from(sentence);
		if (reducedMotion.matches) {
			text.textContent = sentence;
			card.dataset.typing = 'false';
			return;
		}

		text.textContent = '';
		card.dataset.typing = 'true';
		let index = 0;
		const typeNext = () => {
			if (token !== typingToken || !text) return;
			text.textContent += characters[index] ?? '';
			index += 1;
			if (index < characters.length) window.setTimeout(typeNext, 58);
			else card.dataset.typing = 'false';
		};
		typeNext();
	};

	const loadHitokoto = async () => {
		if (!card || !text || !source || !link || requestInFlight || document.hidden) return;

		const controller = new AbortController();
		const timeout = window.setTimeout(() => controller.abort(), 5000);
		requestInFlight = true;
		card.dataset.state = 'loading';

		try {
			const response = await fetch(endpoint, {
				signal: controller.signal,
				cache: 'no-store',
				headers: { Accept: 'application/json' },
			});
			if (!response.ok) throw new Error(`Hitokoto API returned ${response.status}`);

			const data = await response.json() as HitokotoResponse;
			const sentence = asText(data.hitokoto);
			if (!sentence || sentence.length > 60) throw new Error('Hitokoto API returned invalid content');

			const author = asText(data.from_who);
			const origin = asText(data.from);
			const attribution = [author, origin].filter((item, index, items) => item && items.indexOf(item) === index).join(' · ');

			source.textContent = attribution || '一言';
			link.setAttribute('aria-label', `${sentence}，${attribution || '一言'}`);
			const uuid = asText(data.uuid);
			link.href = uuid ? `https://hitokoto.cn/?uuid=${encodeURIComponent(uuid)}` : 'https://hitokoto.cn/';
			typeSentence(sentence);
			card.dataset.state = 'ready';
		} catch {
			card.dataset.state = 'error';
		} finally {
			window.clearTimeout(timeout);
			requestInFlight = false;
		}
	};

	loadHitokoto();
	const refreshTimer = window.setInterval(loadHitokoto, 60_000);
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) loadHitokoto();
	});
	window.addEventListener('pagehide', () => window.clearInterval(refreshTimer), { once: true });
</script>

<style>
	.hitokoto-card {
		display: flex;
		width: 100%;
		min-width: 0;
		min-height: 2rem;
		align-items: center;
		justify-content: center;
		padding: .2rem 1rem 0;
	}
	.hitokoto-content { display: flex; width: fit-content; max-width: 100%; min-width: 0; align-items: center; justify-content: center; gap: .6rem; color: var(--muted); font-family: "STKaiti", "KaiTi", "Noto Serif SC", serif; font-size: .72rem; letter-spacing: .025em; line-height: 1.45; text-decoration: none; }
	.hitokoto-content:hover [data-hitokoto-text] { color: var(--accent-ink); }
	[data-hitokoto-text] { overflow: hidden; min-width: 0; text-overflow: ellipsis; white-space: nowrap; transition: color .2s ease; }
	[data-hitokoto-text]::after { display: inline-block; width: 1px; height: .9em; margin-left: .18rem; background: currentColor; content: ""; animation: hitokoto-caret .9s steps(1, end) infinite; vertical-align: -.06em; }
	.hitokoto-content cite { flex: none; color: var(--muted); font-family: var(--font-body); font-size: .65rem; font-style: normal; letter-spacing: 0; }
	.hitokoto-content cite::before { content: "— "; }
	.hitokoto-card[data-state='loading'] .hitokoto-content { opacity: .72; }
	@keyframes hitokoto-caret { 50% { opacity: 0; } }
	@media (max-width: 700px) {
		.hitokoto-content cite { display: none; }
		.hitokoto-content { font-size: .68rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		[data-hitokoto-text]::after { display: none; }
	}
</style>
