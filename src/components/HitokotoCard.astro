---
import { SITE_TAGLINE } from '../consts';
---

<div class="hitokoto-card shell" data-hitokoto-card>
	<a class="hitokoto-content" data-hitokoto-link href="https://hitokoto.cn/" target="_blank" rel="noreferrer">
		<span data-hitokoto-text>{SITE_TAGLINE}</span>
		<cite data-hitokoto-source>本站格言</cite>
	</a>
</div>

<script>
	interface HitokotoResponse {
		hitokoto?: unknown;
		from?: unknown;
		from_who?: unknown;
		uuid?: unknown;
	}

	const card = document.querySelector<HTMLElement>('[data-hitokoto-card]');
	const text = card?.querySelector<HTMLElement>('[data-hitokoto-text]');
	const source = card?.querySelector<HTMLElement>('[data-hitokoto-source]');
	const link = card?.querySelector<HTMLAnchorElement>('[data-hitokoto-link]');
	const endpoint = new URL('https://v1.hitokoto.cn/');
	let requestInFlight = false;

	['d', 'e', 'i', 'k'].forEach((category) => endpoint.searchParams.append('c', category));
	endpoint.searchParams.set('encode', 'json');
	endpoint.searchParams.set('charset', 'utf-8');
	endpoint.searchParams.set('min_length', '8');
	endpoint.searchParams.set('max_length', '28');

	const asText = (value: unknown) => typeof value === 'string' ? value.trim() : '';

	const loadHitokoto = async () => {
		if (!card || !text || !source || !link || requestInFlight || document.hidden) return;

		const controller = new AbortController();
		const timeout = window.setTimeout(() => controller.abort(), 5000);
		requestInFlight = true;
		card.dataset.state = 'loading';

		try {
			const response = await fetch(endpoint, {
				signal: controller.signal,
				cache: 'no-store',
				headers: { Accept: 'application/json' },
			});
			if (!response.ok) throw new Error(`Hitokoto API returned ${response.status}`);

			const data = await response.json() as HitokotoResponse;
			const sentence = asText(data.hitokoto);
			if (!sentence || sentence.length > 60) throw new Error('Hitokoto API returned invalid content');

			const author = asText(data.from_who);
			const origin = asText(data.from);
			const attribution = [author, origin].filter((item, index, items) => item && items.indexOf(item) === index).join(' · ');

			text.textContent = sentence;
			source.textContent = attribution || '一言';
			const uuid = asText(data.uuid);
			link.href = uuid ? `https://hitokoto.cn/?uuid=${encodeURIComponent(uuid)}` : 'https://hitokoto.cn/';
			card.dataset.state = 'ready';
		} catch {
			card.dataset.state = 'error';
		} finally {
			window.clearTimeout(timeout);
			requestInFlight = false;
		}
	};

	loadHitokoto();
	const refreshTimer = window.setInterval(loadHitokoto, 60_000);
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) loadHitokoto();
	});
	window.addEventListener('pagehide', () => window.clearInterval(refreshTimer), { once: true });
</script>

<style>
	.hitokoto-card {
		display: flex;
		min-height: 3rem;
		align-items: center;
		justify-content: center;
		margin-top: .5rem;
		padding: .65rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-small);
		background: color-mix(in srgb, var(--surface) 90%, transparent);
	}
	.hitokoto-content { display: flex; min-width: 0; align-items: center; justify-content: center; gap: .7rem; color: var(--muted); font-size: .78rem; line-height: 1.45; text-decoration: none; }
	.hitokoto-content:hover [data-hitokoto-text] { color: var(--accent-ink); }
	[data-hitokoto-text] { overflow: hidden; min-width: 0; text-overflow: ellipsis; white-space: nowrap; transition: color .2s ease; }
	.hitokoto-content cite { flex: none; color: color-mix(in srgb, var(--muted) 72%, transparent); font-size: .68rem; font-style: normal; }
	.hitokoto-content cite::before { content: "— "; }
	.hitokoto-card[data-state='loading'] .hitokoto-content { opacity: .72; }
	@media (max-width: 700px) {
		.hitokoto-content cite { display: none; }
	}
	@media (max-width: 520px) {
		.hitokoto-card { padding-inline: .8rem; }
	}
</style>
