---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import HitokotoCard from './HitokotoCard.astro';

const today = new Date();
---

<footer class="site-footer">
	<div class="shell footer-stack">
		<div class="footer-inner">
			<div>
				<p class="footer-title">{SITE_TITLE}</p>
				<p>写点好玩的东西。</p>
			</div>
			<div class="footer-meta">
				<a href="/rss/">RSS 订阅</a>
				<span>© {today.getFullYear()} {SITE_AUTHOR}</span>
			</div>
		</div>
		<HitokotoCard />
	</div>
</footer>

<style>
	.site-footer { margin-top: 4.25rem; padding: 0 0 1.25rem; color: var(--muted); }
	.footer-stack { display: grid; width: min(1060px, calc(100% - 3rem)); gap: .8rem; }
	.footer-inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: 1.35rem 1.6rem; border-radius: 1.15rem; background: var(--surface-blue); }
	.footer-title { margin: 0 0 .3rem; color: var(--ink); font-family: var(--font-display); font-size: 1rem; font-weight: 700; }
	p { margin: 0; font-size: .82rem; }
	.footer-meta { display: flex; align-items: center; gap: 1.05rem; font-size: .78rem; }
	.footer-meta a { color: inherit; text-underline-offset: .25rem; }
	@media (max-width: 640px) {
		.footer-stack { width: min(100% - 2rem, 1060px); }
		.footer-inner { align-items: flex-start; flex-direction: column; gap: 1.1rem; padding: 1.25rem; }
		:global(html[data-music-capsule-visible='true']) .site-footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
	}
</style>
