---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const rawBody = 'body' in post && typeof post.body === 'string' ? post.body : '';
const wordCount = rawBody.replace(/```[\s\S]*?```/g, '').replace(/\s+/g, '').length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 450));
---

<BlogPost {...post.data} headings={headings} readingMinutes={readingMinutes} wordCount={wordCount}>
	<Content />
</BlogPost>
