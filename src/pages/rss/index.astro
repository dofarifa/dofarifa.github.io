---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
const feedUrl = new URL('/rss.xml', Astro.url.origin);
---

<BaseLayout
	title={`RSS 订阅 · ${SITE_TITLE}`}
	description={`通过 RSS 订阅 ${SITE_TITLE} 的最新文章更新。`}
>
	<main class="shell rss-page">
		<section class="rss-hero" aria-labelledby="rss-title">
			<div>
				<h1 id="rss-title">RSS 订阅</h1>
				<p>{SITE_DESCRIPTION} 你可以把这个地址添加到 RSS 阅读器，之后文章更新会自动出现在阅读列表里。</p>
			</div>
			<a class="button button-primary" href="/rss.xml">打开订阅源</a>
		</section>

		<section class="feed-panel" aria-label="订阅地址">
			<p>订阅地址</p>
			<code>{feedUrl.href}</code>
		</section>

		<section class="recent-feed" aria-labelledby="recent-rss-title">
			<h2 id="recent-rss-title">最近文章</h2>
			<div class="recent-list">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`}>
						<span>{post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</span>
						<strong>{post.data.title}</strong>
					</a>
				))}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.rss-page { display: grid; gap: 1.2rem; padding-block: clamp(2rem, 7vh, 5rem); }
	.rss-hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-card); background: linear-gradient(135deg, var(--surface-lilac), var(--surface-blue)); box-shadow: var(--shadow-raised); }
	.rss-hero h1 { margin: 0; font-size: clamp(2rem, 5vw, 4rem); letter-spacing: -.03em; }
	.rss-hero p { max-width: 42rem; margin: .8rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.8; }
	.feed-panel { display: grid; gap: .45rem; padding: 1.1rem 1.3rem; border: 1px solid var(--line); border-radius: 1rem; background: color-mix(in srgb, var(--surface) 86%, transparent); }
	.feed-panel p { margin: 0; color: var(--muted); font-size: .78rem; font-weight: 700; }
	.feed-panel code { overflow-wrap: anywhere; color: var(--ink); font-size: .9rem; }
	.recent-feed { display: grid; gap: .8rem; margin-top: .5rem; }
	.recent-feed h2 { margin: 0; font-size: 1.05rem; }
	.recent-list { display: grid; gap: .55rem; }
	.recent-list a { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; align-items: center; min-height: 3rem; padding: .8rem 1rem; border-radius: 1rem; background: var(--surface); color: var(--ink); text-decoration: none; }
	.recent-list a:hover { background: var(--accent-soft); color: var(--accent-ink); }
	.recent-list span { color: var(--muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
	.recent-list strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .95rem; }
	@media (max-width: 700px) {
		.rss-hero { align-items: flex-start; flex-direction: column; padding: 2rem; }
		.rss-hero .button { width: 100%; }
		.recent-list a { grid-template-columns: 1fr; gap: .2rem; }
	}
</style>
