---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`页面未找到 · ${SITE_TITLE}`} description="你访问的页面不存在。">
	<main class="shell not-found">
		<p>404</p>
		<h1>这一页还没有文字。</h1>
		<span>它可能被移动了，也可能从未存在过。</span>
		<a class="button button-primary" href="/">回到首页</a>
	</main>
</BaseLayout>

<style>
	.not-found { display: flex; min-height: 65vh; align-items: center; flex-direction: column; justify-content: center; margin-top: 2rem; padding: 5rem 2rem; border-radius: 2rem; background: var(--surface-lilac); text-align: center; }
	.not-found > p { margin: 0; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .2em; }
	.not-found h1 { margin: 1rem 0; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -.04em; }
	.not-found > span { margin-bottom: 2rem; color: var(--muted); }
</style>
