---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="shell hero">
			<div class="hero-copy">
				<h1>{SITE_TAGLINE}</h1>
				<p class="intro">这里收集关于技术实践、阅读思考与日常生活的文字。保持好奇，也保持诚实。</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/blog">阅读文章 <span aria-hidden="true">→</span></a>
					<a class="button button-ghost" href="/about">认识我</a>
				</div>
			</div>
			<div class="hero-art" aria-hidden="true">
				<div class="sun"></div>
				<div class="orbit orbit-one"></div>
				<div class="orbit orbit-two"></div>
				<span>思</span><span>读</span><span>写</span>
			</div>
		</section>

		{featuredPost && (
			<section class="shell section-block">
				<div class="section-heading"><h2>推荐阅读</h2></div>
				<a class="featured-card" href={`/blog/${featuredPost.id}/`}>
					{featuredPost.data.heroImage && <Image src={featuredPost.data.heroImage} width={960} height={560} alt="" />}
					<div class="featured-copy">
						<div class="post-meta"><FormattedDate date={featuredPost.data.pubDate} /><span>·</span><span>{featuredPost.data.tags[0] ?? '随笔'}</span></div>
						<h3>{featuredPost.data.title}</h3>
						<p>{featuredPost.data.description}</p>
						<span class="text-link">继续阅读 <span aria-hidden="true">↗</span></span>
					</div>
				</a>
			</section>
		)}

		<section class="shell section-block">
			<div class="section-heading heading-row"><h2>最近更新</h2><a href="/blog">全部文章 →</a></div>
			<div class="post-grid">
				{recentPosts.map((post) => (
					<a class="post-card" href={`/blog/${post.id}/`}>
						<p class="post-meta"><FormattedDate date={post.data.pubDate} /></p>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
						<ul class="tag-list" aria-label="文章标签">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
					</a>
				))}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.hero { display: grid; min-height: 36rem; grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(3rem, 7vw, 6rem); margin-top: 2rem; padding: clamp(2.5rem, 6vw, 5.5rem); border-radius: 2rem; background: var(--surface-lilac); }
	.hero-copy h1 { max-width: 12ch; margin: 0 0 1.5rem; font-size: clamp(3rem, 6.2vw, 6rem); letter-spacing: -.04em; line-height: 1; }
	.intro { max-width: 37rem; color: var(--muted); font-size: 1.08rem; line-height: 1.9; }
	.hero-actions { display: flex; gap: .75rem; margin-top: 2rem; }
	.hero-art { position: relative; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent); border-radius: 50%; }
	.sun { position: absolute; inset: 25%; border-radius: 50%; background: var(--sun); box-shadow: 0 18px 45px var(--sun-shadow); }
	.orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent); border-radius: 50%; transform: rotate(-24deg); }
	.orbit-one { inset: 10% -12%; }
	.orbit-two { inset: -12% 10%; transform: rotate(32deg); }
	.hero-art span { position: absolute; display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: 50%; background: var(--surface); color: var(--accent-ink); font-size: .8rem; box-shadow: 0 8px 24px var(--decor-shadow); }
	.hero-art span:nth-of-type(1) { top: 3%; left: 45%; } .hero-art span:nth-of-type(2) { right: -3%; bottom: 27%; } .hero-art span:nth-of-type(3) { bottom: 4%; left: 8%; }
	.section-block { padding-block: 5rem; }
	.section-heading { margin-bottom: 2rem; }
	.section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.03em; }
	.heading-row { display: flex; align-items: flex-end; justify-content: space-between; }
	.heading-row > a { color: var(--muted); font-size: .9rem; text-decoration: none; }
	.featured-card { display: grid; overflow: hidden; grid-template-columns: 1.15fr .85fr; border-radius: var(--radius-card); background: var(--surface); color: var(--ink); box-shadow: var(--shadow); text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
	.featured-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-raised); }
	.featured-card :global(img) { width: 100%; height: 100%; min-height: 25rem; object-fit: cover; border-radius: 0; }
	.featured-copy { display: flex; align-items: flex-start; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 4.5rem); }
	.featured-copy h3 { margin: 1rem 0; font-size: clamp(2rem, 3.5vw, 3.5rem); letter-spacing: -.04em; }
	.featured-copy > p { color: var(--muted); line-height: 1.8; }
	.post-meta { display: flex; gap: .6rem; color: var(--muted); font-size: .78rem; }
	.text-link { margin-top: 1.5rem; color: var(--accent); font-size: .9rem; font-weight: 700; }
	.post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.post-card { min-height: 18rem; padding: 2rem; border-radius: var(--radius-card); background: var(--surface-blue); color: var(--ink); text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
	.post-card:nth-child(2) { background: var(--surface-peach); }
	.post-card:nth-child(3) { background: var(--surface-mint); }
	.post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
	.post-card h3 { margin: 2rem 0 .8rem; font-size: 1.55rem; }
	.post-card > p:not(.post-meta) { color: var(--muted); font-size: .93rem; line-height: 1.75; }
	.tag-list { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
	.tag-list li { padding: .3rem .6rem; border-radius: 999px; background: color-mix(in srgb, var(--surface) 72%, transparent); color: var(--muted); font-size: .72rem; }
	@media (max-width: 800px) { .hero { min-height: auto; grid-template-columns: 1fr; padding: 3rem; } .hero-art { width: min(70vw, 20rem); margin: 0 auto; } .featured-card { grid-template-columns: 1fr; } .featured-card :global(img) { min-height: 15rem; max-height: 24rem; } .post-grid { grid-template-columns: 1fr; } .post-card { min-height: 0; } }
	@media (max-width: 520px) { .hero { margin-top: 1rem; padding: 2rem 1.25rem 2.5rem; border-radius: var(--radius-card); } .hero-copy h1 { font-size: 3.15rem; } .section-block { padding-block: 3rem; } .heading-row { align-items: flex-start; flex-direction: column; gap: 1rem; } }
</style>
