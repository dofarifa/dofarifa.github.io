---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AVATAR_CARD_BACKGROUND, HOME_BANNER_VIDEO, SITE_AVATAR, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 4);
const tagCounts = [...new Set(posts.flatMap((post) => post.data.tags))]
	.map((tag) => ({ tag, count: posts.filter((post) => post.data.tags.includes(tag)).length }));
const earliestYear = posts.length ? Math.min(...posts.map((post) => post.data.pubDate.getFullYear())) : new Date().getFullYear();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="shell hero">
			{HOME_BANNER_VIDEO && (
				<div class="hero-media" aria-hidden="true">
					<video class="hero-video" data-src={HOME_BANNER_VIDEO} muted loop playsinline preload="none" data-hero-video></video>
				</div>
			)}
			<h1 class="sr-only">{SITE_TAGLINE}</h1>
			<div class="hero-actions">
				<a class="button button-primary" href="/blog">
					阅读文章
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
				</a>
				<a class="button button-ghost" href="/about">认识我</a>
			</div>
		</section>

		<nav class="shell topic-bar" aria-label="文章分类">
			<a class="is-active" href="/blog">全部</a>
			{tagCounts.slice(0, 6).map(({ tag }) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
			<a class="topic-more" href="/blog" aria-label="浏览全部分类">
				<span>更多</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
			</a>
		</nav>

		<div class="shell content-layout">
			<div class="content-main">
				<div class="section-heading heading-row">
					<div><h2>最近更新</h2><p>新写下的思考与实践</p></div>
					<a href="/blog">查看全部</a>
				</div>

				{featuredPost && (
					<a class="featured-card" href={`/blog/${featuredPost.id}/`}>
						{featuredPost.data.heroImage && <Image src={featuredPost.data.heroImage} width={960} height={560} alt="" />}
						<div class="featured-copy">
							<div class="post-meta"><span>推荐阅读</span><FormattedDate date={featuredPost.data.pubDate} /></div>
							<h3>{featuredPost.data.title}</h3>
							<p>{featuredPost.data.description}</p>
							<span class="text-link">继续阅读 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></span>
						</div>
					</a>
				)}

				<div class="post-grid">
					{recentPosts.map((post) => (
						<a class="post-card" href={`/blog/${post.id}/`}>
							{post.data.heroImage && <Image src={post.data.heroImage} width={640} height={400} alt="" />}
							<div class="post-card-copy">
								<p class="post-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.tags[0] ?? '随笔'}</span></p>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					))}
				</div>
			</div>

			<aside class="sidebar" aria-label="博客信息">
				<section class="profile-card">
					<div class="profile-cover" style={`--avatar-card-background: ${AVATAR_CARD_BACKGROUND};`}><Image src={SITE_AVATAR} width={144} height={144} format="webp" quality={80} loading="lazy" alt={`${SITE_TITLE} 的头像`} /></div>
					<div class="profile-copy">
						<h2>{SITE_TITLE}</h2>
						<p>{SITE_DESCRIPTION}</p>
						<a class="button button-ghost" href="/about">了解更多</a>
					</div>
				</section>

				<section class="side-card">
					<h2>博客小记</h2>
					<dl class="stats">
						<div><dt>文章</dt><dd>{posts.length}</dd></div>
						<div><dt>标签</dt><dd>{tagCounts.length}</dd></div>
						<div><dt>始于</dt><dd>{earliestYear}</dd></div>
					</dl>
				</section>

				<section class="side-card">
					<div class="side-heading"><h2>标签</h2><a href="/blog">全部</a></div>
					<ul class="tag-cloud">
						{tagCounts.map(({ tag, count }) => <li><a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}<sup>{count}</sup></a></li>)}
					</ul>
				</section>
			</aside>
		</div>
	</main>

	<script>
		const setupHeroVideo = () => {
			document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((video) => {
				if (video.dataset.initialized === 'true') return;
				video.dataset.initialized = 'true';
				video.muted = true;
				video.loop = true;
				video.playsInline = true;
				video.defaultMuted = true;
				video.autoplay = true;
				video.preload = 'none';

				const media = video.closest<HTMLElement>('.hero-media');
				const connection = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
				const shouldKeepStatic = connection?.saveData || ['slow-2g', '2g'].includes(connection?.effectiveType ?? '');

				const playVideo = () => {
					if (!document.hidden && video.src) void video.play().catch(() => undefined);
				};

				const loadVideo = () => {
					if (!video.src && video.dataset.src) {
						video.src = video.dataset.src;
						video.preload = 'metadata';
						video.load();
					}
					playVideo();
				};

				const scheduleLoad = () => {
					if (shouldKeepStatic) {
						media?.classList.add('is-static');
						return;
					}

					if ('requestIdleCallback' in window) {
						window.requestIdleCallback(loadVideo, { timeout: 1200 });
						return;
					}

					window.setTimeout(loadVideo, 350);
				};

				video.addEventListener('ended', () => {
					video.currentTime = 0;
					playVideo();
				});
				video.addEventListener('canplay', () => {
					media?.classList.add('is-ready');
					playVideo();
				}, { once: true });
				video.addEventListener('loadeddata', () => media?.classList.add('is-ready'), { once: true });
				document.addEventListener('visibilitychange', playVideo);
				const observer = 'IntersectionObserver' in window
					? new IntersectionObserver(([entry]) => {
							if (entry?.isIntersecting) {
								scheduleLoad();
								playVideo();
								return;
							}

							video.pause();
						}, { rootMargin: '180px 0px' })
					: null;

				observer?.observe(video);
				document.addEventListener('astro:before-swap', () => {
					document.removeEventListener('visibilitychange', playVideo);
					observer?.disconnect();
				}, { once: true });

				if (!observer) scheduleLoad();
			});
		};

		setupHeroVideo();
		document.addEventListener('astro:page-load', setupHeroVideo);
	</script>
</BaseLayout>

<style>
	.hero { position: relative; display: flex; overflow: hidden; min-height: clamp(27rem, 48vw, 38rem); align-items: flex-end; margin-top: 1rem; padding: clamp(1.5rem, 3.5vw, 3rem); border: 1px solid color-mix(in srgb, var(--accent) 10%, transparent); border-radius: 2rem; background: linear-gradient(135deg, #211d34, #3a3154 52%, #151723); box-shadow: 0 1.5rem 4.5rem color-mix(in srgb, var(--decor-shadow) 58%, transparent); isolation: isolate; contain: paint; }
	.hero-media { position: absolute; z-index: -3; inset: 0; overflow: hidden; border-radius: inherit; background: radial-gradient(circle at 26% 22%, rgba(159, 140, 255, .34), transparent 34%), linear-gradient(135deg, #211d34, #3a3154 52%, #151723); }
	.hero-media::before { position: absolute; inset: 0; background: linear-gradient(110deg, transparent 26%, rgba(255, 255, 255, .1) 42%, transparent 58%); content: ""; opacity: .32; transform: translateX(-100%); animation: hero-loading-sheen 1.8s ease-in-out infinite; pointer-events: none; }
	.hero-media.is-ready::before, .hero-media.is-static::before { opacity: 0; animation: none; }
	.hero-video { position: absolute; top: 50%; left: 50%; width: 100%; height: 100%; min-width: 100%; min-height: 100%; object-fit: cover; object-position: center; opacity: 0; filter: saturate(1.02) contrast(.98) brightness(.94); transform: translate(-50%, -50%) scale(1.22); transition: opacity .5s ease; }
	.hero-media.is-ready .hero-video { opacity: 1; }
	.hero::after { position: absolute; z-index: -2; inset: 0; background: linear-gradient(180deg, transparent 18%, rgba(20, 18, 32, .18) 62%, rgba(20, 18, 32, .42)); content: ""; pointer-events: none; }
	.hero-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .8rem; }
	.hero-actions svg, .text-link svg, .topic-more svg { width: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
	.topic-bar { display: flex; overflow-x: auto; align-items: center; gap: .35rem; margin-top: 1rem; padding: .55rem; border: 1px solid var(--line); border-radius: var(--radius-small); background: var(--surface); scrollbar-width: none; }
	.topic-bar::-webkit-scrollbar { display: none; }
	.topic-bar a { display: inline-flex; min-height: 2.35rem; flex: none; align-items: center; justify-content: center; padding: .55rem .9rem; border-radius: .72rem; color: var(--muted); font-size: .82rem; font-weight: 650; line-height: 1; text-decoration: none; }
	.topic-bar a:hover { background: var(--paper-deep); color: var(--ink); }
	.topic-bar .is-active { background: var(--accent); color: var(--accent-contrast); }
	.topic-bar .topic-more { gap: .35rem; margin-left: auto; }
	.content-layout { display: grid; grid-template-columns: minmax(0, 1fr) 18.5rem; align-items: start; gap: 1rem; padding-block: 4.5rem; }
	.content-main { min-width: 0; }
	.section-heading { margin-bottom: 1.5rem; }
	.section-heading h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.03em; }
	.section-heading p { margin: .35rem 0 0; color: var(--muted); font-size: .82rem; }
	.heading-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
	.heading-row > a { color: var(--muted); font-size: .82rem; text-decoration: none; }
	.heading-row > a:hover { color: var(--accent-ink); }
	.featured-card { display: grid; overflow: hidden; grid-template-columns: 1.05fr .95fr; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
	.featured-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
	.featured-card :global(img) { width: 100%; height: 100%; min-height: 22rem; object-fit: cover; border-radius: 0; }
	.featured-copy { display: flex; align-items: flex-start; flex-direction: column; justify-content: center; padding: clamp(1.75rem, 4vw, 3rem); }
	.featured-copy h3 { margin: .85rem 0; font-size: clamp(1.8rem, 3vw, 2.7rem); letter-spacing: -.035em; }
	.featured-copy > p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.75; }
	.post-meta { display: flex; flex-wrap: wrap; gap: .65rem; margin: 0; color: var(--muted); font-size: .72rem; }
	.featured-copy .post-meta span:first-child { color: var(--accent-ink); font-weight: 700; }
	.text-link { display: inline-flex; align-items: center; gap: .25rem; margin-top: 1.4rem; color: var(--accent-ink); font-size: .82rem; font-weight: 700; }
	.post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
	.post-card { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
	.post-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
	.post-card :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
	.post-card-copy { padding: 1.25rem; }
	.post-card h3 { margin: .8rem 0 .55rem; font-size: 1.25rem; }
	.post-card-copy > p:last-child { display: -webkit-box; overflow: hidden; margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.sidebar { position: sticky; top: 8.5rem; display: grid; gap: 1rem; }
	.profile-card, .side-card { border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
	.profile-card { position: relative; overflow: hidden; }
	.side-card { overflow: hidden; }
	.profile-cover { position: relative; min-height: 7.25rem; background: var(--avatar-card-background); }
	.profile-cover img { position: absolute; bottom: -2.8rem; left: 1.3rem; width: 5.6rem; height: 5.6rem; border: .4rem solid var(--surface); border-radius: 50%; object-fit: cover; box-shadow: var(--shadow); }
	.profile-copy { padding: 3.65rem 1.3rem 1.3rem; }
	.profile-copy h2, .side-card h2 { margin: 0; font-size: 1.1rem; }
	.profile-copy p { margin: .55rem 0 1.1rem; color: var(--muted); font-size: .78rem; line-height: 1.65; }
	.profile-copy .button { width: 100%; min-height: 2.6rem; font-size: .78rem; }
	.side-card { padding: 1.3rem; }
	.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; margin: 1rem 0 0; }
	.stats div { padding: .7rem .45rem; border-radius: .75rem; background: var(--paper); text-align: center; }
	.stats dt { color: var(--muted); font-size: .68rem; }
	.stats dd { margin: .15rem 0 0; color: var(--ink); font-family: var(--font-display); font-size: .95rem; font-weight: 700; }
	.side-heading { display: flex; align-items: center; justify-content: space-between; }
	.side-heading > a { color: var(--muted); font-size: .72rem; text-decoration: none; }
	.tag-cloud { display: flex; flex-wrap: wrap; gap: .45rem .7rem; margin: 1rem 0 0; padding: 0; list-style: none; }
	.tag-cloud a { color: var(--muted); font-size: .78rem; text-decoration: none; }
	.tag-cloud a:hover { color: var(--accent-ink); }
	.tag-cloud sup { margin-left: .12rem; color: var(--accent); font-size: .6rem; }
	:global([data-theme='dark']) .hero-video { filter: saturate(.95) contrast(.98) brightness(.78); }
	:global([data-theme='dark']) .profile-card { background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 88%, #ffffff 6%), var(--surface)); }
	:global([data-theme='dark']) .profile-cover { background: var(--avatar-card-background); }
	:global([data-theme='dark']) .profile-cover img { border-color: color-mix(in srgb, var(--surface) 80%, white 12%); box-shadow: 0 1rem 2.2rem rgba(0, 0, 0, .34); }
	@media (max-width: 960px) {
		.content-layout { grid-template-columns: 1fr; }
		.sidebar { position: static; grid-template-columns: 1.2fr 1fr 1fr; }
	}
	@media (max-width: 800px) {
		.hero { min-height: 25rem; padding: 1.5rem; }
		.hero-video { transform: translate(-50%, -50%) scale(1.34); }
		.featured-card { grid-template-columns: 1fr; }
		.featured-card :global(img) { min-height: 14rem; max-height: 22rem; }
		.sidebar { grid-template-columns: 1fr; }
	}
	@media (max-width: 620px) {
		.post-grid { grid-template-columns: 1fr; }
		.content-layout { padding-block: 3rem; }
	}
	@media (max-width: 520px) {
		.hero { min-height: 22rem; margin-top: .75rem; padding: 1rem; border-radius: var(--radius-card); }
		.hero-video { transform: translate(-50%, -50%) scale(1.48); }
		.hero-actions { width: 100%; }
		.hero-actions .button { flex: 1; min-width: 0; }
		.heading-row { align-items: flex-start; }
		.topic-bar { width: calc(100% - 1rem); }
		.featured-copy { padding: 1.5rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-video, .hero-media::before { display: none; }
	}
	@keyframes hero-loading-sheen { to { transform: translateX(100%); } }
</style>
