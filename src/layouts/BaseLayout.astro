---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import GlobalMusicPlayer from '../components/GlobalMusicPlayer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	designContract?: string;
}

const { title, description, image, designContract } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		{designContract && <Fragment set:html={designContract} />}
		<Header />
		<slot />
		<Footer />
		<GlobalMusicPlayer />
		<BackToTop />
	</body>
</html>
