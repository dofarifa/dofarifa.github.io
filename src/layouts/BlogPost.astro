---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CommentSection from '../components/CommentSection.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import { GITHUB_PROFILE_URL, SITE_AVATAR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from './BaseLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	readingMinutes?: number;
	wordCount?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags,
	headings = [],
	readingMinutes = 1,
	wordCount = 0,
} = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={title} description={description} image={heroImage}>
	<main>
		<article>
			<header class="article-hero">
				{heroImage && <Image class="article-hero-bg" width={1800} height={920} src={heroImage} alt="" loading="eager" fetchpriority="high" />}
				<div class="article-hero-shade" aria-hidden="true"></div>
				<div class="article-stars" aria-hidden="true"></div>
				<div class="shell article-hero-inner">
					<a class="back-link" href="/blog">返回文章</a>
					<div class="article-tags" aria-label="文章标签">
						{tags.map((tag) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
					</div>
					<h1>{title}</h1>
					<p>{description}</p>
					<div class="article-meta" aria-label="文章信息">
						<span>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4M16 2v4M4 10h16M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg>
							<FormattedDate date={pubDate} />
						</span>
						<span>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Zm3 12h10M9 8h5" /></svg>
							{wordCount || '若干'} 字
						</span>
						<span>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
							{readingMinutes} 分钟
						</span>
						{updatedDate && (
							<span>
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2M21 4v6h-6M21 12a9 9 0 0 1-15.5 6.2M3 20v-6h6" /></svg>
								更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
				</div>
			</header>

			<div class="shell article-layout">
				<div class="article-main">
					<section class="article-summary" aria-label="文章摘要">
						<div>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12a2 2 0 0 1 2 2v11a3 3 0 0 1-3 3H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 5h6M9 13h4" /></svg>
							<strong>文章摘要</strong>
						</div>
						<p>{description}</p>
					</section>
					<div class="prose article-body"><slot /></div>
				</div>

				<aside class="article-sidebar" aria-label="文章侧边栏">
					<section class="author-card">
						<div class="author-card-inner">
							<div class="author-face author-front">
								<div class="author-cover" aria-hidden="true"></div>
								<Image src={SITE_AVATAR} width={112} height={112} format="webp" quality={82} loading="lazy" alt={`${SITE_TITLE} 的头像`} />
								<h2>{SITE_TITLE}</h2>
								<p>{SITE_DESCRIPTION}</p>
							</div>
							<div class="author-face author-back" aria-label="GitHub 链接">
								<a class="author-github" href={GITHUB_PROFILE_URL} target="_blank" rel="noreferrer" aria-label={`打开 ${SITE_TITLE} 的 GitHub 主页`}>
									<GitHubIcon />
								</a>
							</div>
						</div>
					</section>
					{visibleHeadings.length > 0 && (
						<nav class="toc-card" aria-label="文章目录">
							<h2>目录</h2>
							<ol>
								{visibleHeadings.map((heading) => (
									<li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
								))}
							</ol>
						</nav>
					)}
				</aside>
			</div>

			<div class="shell article-comments-layout">
				<div class="article-comments">
					<CommentSection title={title} />
				</div>
			</div>

		</article>
	</main>
</BaseLayout>

<style>
	:global(body .site-header) { --header-bg-start: rgba(15, 20, 24, .48); --header-bg-mid: rgba(15, 20, 24, .25); --header-bg-end: rgba(15, 20, 24, 0); --header-brand-color: rgba(245, 248, 247, .9); --header-link-color: rgba(245, 248, 247, .72); --header-link-hover-color: #fff; --header-link-hover-bg: transparent; --header-link-active-color: #fff; --header-link-active-bg: transparent; --header-link-indicator: rgba(179, 244, 205, .86); --header-link-indicator-opacity: .72; --header-tool-color: rgba(245, 248, 247, .72); --header-tool-hover-color: #fff; --header-tool-hover-bg: rgba(255, 255, 255, .08); --header-mark-bg: rgba(255, 255, 255, .08); --header-mark-shadow: 0 .7rem 1.8rem rgba(0, 0, 0, .18); position: absolute !important; top: 0; right: 0; left: 0; padding-block: .72rem 1rem; }
	.article-hero { position: relative; overflow: hidden; min-height: clamp(29rem, 56vh, 39rem); margin-top: 0; padding-top: 9.4rem; background: #132427; isolation: isolate; }
	.article-hero::after { position: absolute; z-index: 0; right: 0; bottom: -1px; left: 0; height: clamp(3rem, 6vw, 5rem); background: var(--paper); clip-path: polygon(0 58%, 50% 86%, 100% 58%, 100% 100%, 0 100%); content: ""; pointer-events: none; }
	.article-hero-bg { position: absolute; z-index: -4; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .12; filter: saturate(.72) contrast(.9); transform: translateZ(0); }
	.article-hero-shade { position: absolute; z-index: -3; inset: 0; background: radial-gradient(circle at 78% 22%, rgba(86, 126, 169, .48), transparent 28rem), radial-gradient(circle at 58% 52%, rgba(164, 175, 164, .32), transparent 30rem), linear-gradient(96deg, rgba(31, 61, 55, .96) 0%, rgba(40, 64, 62, .92) 44%, rgba(35, 56, 74, .9) 100%); }
	.article-stars { position: absolute; z-index: -2; inset: 0; opacity: .46; background-image: radial-gradient(circle, rgba(245, 237, 151, .62) 0 1px, transparent 1.7px), radial-gradient(circle, rgba(218, 230, 255, .55) 0 1px, transparent 1.8px), radial-gradient(circle, rgba(255, 255, 255, .38) 0 1px, transparent 1.6px); background-position: 2rem 1.6rem, 7rem 4.4rem, 13rem 2.8rem; background-size: 7.2rem 6.4rem, 10rem 8rem, 13rem 9rem; mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 82%, transparent 100%); pointer-events: none; }
	.article-hero-inner { position: relative; z-index: 1; display: grid; align-content: center; min-height: clamp(19rem, 39vh, 27rem); color: white; }
	.back-link { width: fit-content; margin-bottom: 1.15rem; color: color-mix(in srgb, white 82%, transparent); font-size: .8rem; font-weight: 700; text-decoration: none; }
	.back-link:hover { color: white; }
	.article-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 1.1rem; }
	.article-tags a { padding: .36rem .62rem; border-radius: 999px; background: color-mix(in srgb, white 18%, transparent); color: white; font-size: .74rem; font-weight: 700; text-decoration: none; backdrop-filter: blur(12px); }
	.article-hero h1 { max-width: 24ch; margin: 0; color: white; font-size: clamp(2.6rem, 6vw, 5rem); letter-spacing: -.04em; text-shadow: 0 .5rem 1.7rem rgba(27, 82, 56, .18); }
	.article-hero-inner > p { max-width: 56rem; margin: 1.2rem 0 0; color: color-mix(in srgb, white 82%, transparent); font-size: 1rem; line-height: 1.8; }
	.article-meta { display: flex; flex-wrap: wrap; gap: .95rem; margin-top: 1.25rem; color: color-mix(in srgb, white 78%, transparent); font-size: .78rem; font-weight: 650; }
	.article-meta span { display: inline-flex; align-items: center; gap: .35rem; }
	.article-meta svg { width: .9rem; height: .9rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.9; }
	.article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 18.5rem; align-items: start; gap: 1rem; margin-top: 1.25rem; }
	.article-comments-layout { display: grid; grid-template-columns: minmax(0, 1fr) 18.5rem; gap: 1rem; margin-top: 1rem; }
	.article-comments { grid-column: 1; min-width: 0; }
	.article-main { min-width: 0; padding: 1.2rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: var(--shadow); }
	.article-summary { padding: 1.05rem 1.2rem; border: 1px solid color-mix(in srgb, var(--accent) 12%, var(--line)); border-radius: 1rem; background: color-mix(in srgb, var(--surface-lilac) 46%, var(--surface)); }
	.article-summary div { display: inline-flex; align-items: center; gap: .42rem; color: var(--accent-ink); font-size: .82rem; font-weight: 800; }
	.article-summary svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.article-summary p { margin: .6rem 0 0; color: var(--prose-ink); font-size: .9rem; line-height: 1.85; }
	.article-body { max-width: 75ch; margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) clamp(1rem, 3.5vw, 2.4rem); background: transparent; box-shadow: none; }
	.article-sidebar { position: sticky; top: 8.2rem; display: grid; gap: .75rem; }
	.toc-card { overflow: hidden; border: 1px solid var(--line); border-radius: 1.15rem; background: var(--surface); box-shadow: 0 .8rem 2rem color-mix(in srgb, var(--ink) 7%, transparent); }
	.author-card { position: relative; min-height: 17.5rem; border-radius: 1.15rem; perspective: 1100px; }
	.author-card-inner { position: absolute; inset: 0; border-radius: inherit; transform: translateZ(0) rotateY(0deg); transform-style: preserve-3d; transition: transform .64s cubic-bezier(.16, 1, .3, 1); will-change: transform; }
	.author-card:hover .author-card-inner, .author-card:has(.author-github:focus-visible) .author-card-inner { transform: translateZ(0) rotateY(180deg); }
	.author-face { position: absolute; inset: 0; overflow: hidden; border: 1px solid var(--line); border-radius: inherit; background: var(--surface); box-shadow: 0 .8rem 2rem color-mix(in srgb, var(--ink) 7%, transparent); backface-visibility: hidden; transform: translateZ(.1px); -webkit-backface-visibility: hidden; }
	.author-front { padding: 11rem 1.15rem 1.2rem; }
	.author-back { display: grid; place-items: center; background: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 40%), linear-gradient(145deg, var(--surface-lilac), var(--surface)); pointer-events: none; transform: rotateY(180deg) translateZ(.1px); }
	.author-card:hover .author-front, .author-card:has(.author-github:focus-visible) .author-front { pointer-events: none; }
	.author-card:hover .author-back, .author-card:has(.author-github:focus-visible) .author-back { pointer-events: auto; }
	.author-cover { position: absolute; inset: 0 0 auto; height: 9.4rem; background: var(--avatar-card-background); }
	.author-card img { position: absolute; top: 5.2rem; left: 1.15rem; width: 5.2rem; height: 5.2rem; border: .34rem solid color-mix(in srgb, var(--surface) 90%, transparent); border-radius: 50%; object-fit: cover; box-shadow: var(--shadow); }
	.author-card h2 { margin: 0; font-size: 1rem; }
	.author-card p { margin: .35rem 0 0; color: var(--muted); font-size: .74rem; line-height: 1.6; }
	.author-github { display: grid; width: 4.7rem; height: 4.7rem; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--surface) 88%, transparent); color: var(--ink); box-shadow: 0 1rem 2.2rem color-mix(in srgb, var(--ink) 20%, transparent); transition: transform .22s ease, background-color .2s ease, color .2s ease; }
	.author-github:hover { background: var(--accent); color: var(--accent-contrast); transform: scale(1.05); }
	.author-github svg { width: 2.45rem; height: 2.45rem; fill: currentColor; }
	.toc-card { padding: 1.15rem; }
	.toc-card h2 { margin: 0 0 .65rem; font-size: .98rem; }
	.toc-card ol { display: grid; gap: .2rem; max-height: min(26rem, 52vh); overflow: auto; margin: 0; padding: 0; list-style: none; }
	.toc-card a { display: block; overflow: hidden; padding: .45rem .55rem; border-radius: .65rem; color: var(--muted); font-size: .76rem; line-height: 1.35; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
	.toc-card a:hover { background: var(--accent-soft); color: var(--accent-ink); }
	.toc-card .depth-3 a { padding-left: 1.2rem; font-size: .7rem; }
	:global([data-theme='dark']) .article-main { background: color-mix(in srgb, var(--surface) 92%, transparent); }
	:global([data-theme='dark']) .author-cover { background: var(--avatar-card-background); }
	@media (prefers-reduced-motion: reduce) {
		.author-card-inner, .author-github { transition: none; }
		.author-card:hover .author-card-inner, .author-card:has(.author-github:focus-visible) .author-card-inner { transform: none; }
		.author-back { opacity: 0; transform: none; transition: opacity .15s ease; }
		.author-card:hover .author-back, .author-card:has(.author-github:focus-visible) .author-back { opacity: 1; }
	}
	@media (max-width: 920px) {
		.article-layout { grid-template-columns: 1fr; }
		.article-comments-layout { grid-template-columns: 1fr; }
		.article-sidebar { position: static; grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 680px) {
		.article-hero { min-height: 27rem; margin-top: 0; padding-top: 8.1rem; }
		.article-hero::after { height: 3rem; clip-path: polygon(0 68%, 52% 86%, 100% 68%, 100% 100%, 0 100%); }
		.article-hero h1 { font-size: clamp(2.25rem, 11vw, 3.5rem); }
		.article-layout { width: min(100% - 1rem, 1180px); margin-top: .85rem; }
		.article-comments-layout { width: min(100% - 1rem, 1180px); }
		.article-main { padding: .75rem; border-radius: 1.15rem; }
		.article-body { padding: 1.6rem .4rem; }
		.article-sidebar { grid-template-columns: 1fr; }
		.article-meta { gap: .65rem; }
	}
</style>
